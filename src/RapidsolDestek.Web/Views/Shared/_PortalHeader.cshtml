@using RapidsolDestek.Web.Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<RapidsolDestek.Web.SharedResources> SL
@inject RapidsolDestek.Infrastructure.Services.ISettingsService Settings
@{
    var navKey = ViewData["NavKey"] as string;
    // admin/settings-kb master switch (S7, B3): the KB nav item disappears while off.
    var kbEnabled = (await Settings.GetKbAsync()).EnableKb;
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "";
    var orgName = User.FindFirst("OrganizationName")?.Value ?? "";
    var nameParts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = nameParts.Length == 0 ? "" :
        nameParts.Length == 1 ? char.ToUpperInvariant(nameParts[0][0]).ToString() :
        $"{char.ToUpperInvariant(nameParts[0][0])}{char.ToUpperInvariant(nameParts[^1][0])}";
}
<header class="rc-header">
    <a class="rc-logo" href="/">
        <span class="rc-logo-mark"></span>
        <span>RAPID<span class="rc-logo-accent">SOL</span></span>
    </a>
    <nav class="rc-nav" aria-label="Main">
        @foreach (var item in NavConfig.Portal)
        {
            if (item.Key == "kb" && !kbEnabled)
            {
                continue;
            }
            <a class="rc-nav-button @(item.Key == navKey ? "rc-selected" : "")" href="@item.Url">@SL[item.LabelKey]</a>
        }
    </nav>
    <partial name="_LanguageSelect" />
    <details class="rd-account-menu">
        <summary>
            <span class="rc-account" style="text-decoration:none;color:inherit">
                <span class="rc-account-copy">@fullName<small>@orgName</small></span>
                <span class="rd-avatar">@initials</span>
            </span>
        </summary>
        <div class="menu">
            <a href="/profile">@SL["nav.myProfile"]</a>
            <form method="post" action="/logout">
                @Html.AntiForgeryToken()
                <button type="submit">@SL["account.logout"]</button>
            </form>
        </div>
    </details>
</header>
