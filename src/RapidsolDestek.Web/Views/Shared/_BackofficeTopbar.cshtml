@model string
@inject Microsoft.Extensions.Localization.IStringLocalizer<RapidsolDestek.Web.SharedResources> SL
@{
    var panel = Model;
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "";
    var nameParts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = nameParts.Length == 0 ? "" :
        nameParts.Length == 1 ? char.ToUpperInvariant(nameParts[0][0]).ToString() :
        $"{char.ToUpperInvariant(nameParts[0][0])}{char.ToUpperInvariant(nameParts[^1][0])}";
    var isAdmin = User.IsInRole("Admin");
    var home = panel == "admin" ? "/admin/dashboard" : "/agent/dashboard";
}
<div class="bo-topbar">
    <a class="rc-logo" href="@home">
        <span class="rc-logo-mark"></span>
        <span>RAPID<span class="rc-logo-accent">SOL</span></span>
    </a>
    @if (panel == "agent")
    {
        @* B9 global search: rd.js debounces input and fills the dropdown from /agent/search. *@
        <div class="bo-search">
            <input type="search" placeholder="@SL["topbar.search"]" autocomplete="off"
                   data-global-search="/agent/search">
            <div class="bo-search-results" hidden></div>
        </div>
    }
    else
    {
        @* TODO(S7): admin topbar search (B9 adds settings scope) — wire to an admin endpoint when the admin area ports. *@
        <div class="bo-search"><input type="search" placeholder="@SL["topbar.search"]"></div>
    }
    <div class="bo-topbar-right">
        <nav class="bo-panel-switch" aria-label="Panels">
            <a href="/">@SL["panel.portal"]</a>
            <a href="/agent/dashboard" class="@(panel == "agent" ? "active" : "")">@SL["panel.agent"]</a>
            @if (isAdmin)
            {
                <a href="/admin/dashboard" class="@(panel == "admin" ? "active" : "")">@SL["panel.admin"]</a>
            }
        </nav>
        <partial name="_LanguageSelect" />
        <details class="rd-account-menu">
            <summary><span class="rd-avatar" title="@fullName">@initials</span></summary>
            <div class="menu">
                <a href="/agent/profile">@SL["nav.myProfile"]</a>
                <form method="post" action="/@(panel)/logout">
                    @Html.AntiForgeryToken()
                    <button type="submit">@SL["account.logout"]</button>
                </form>
            </div>
        </details>
    </div>
</div>
