@using System.Globalization
@inject RapidsolDestek.Infrastructure.Services.ISettingsService Settings
@{
    var panel = (ViewContext.RouteData.Values["area"] as string ?? "Agent").ToLowerInvariant();
    // Browser-tab title = the configured helpdesk name (admin/settings-system
    // "Yardım masası adı / başlığı", S7; core/helpdesk_title, seeded "RapidsolDestek").
    var helpdeskTitle = await Settings.GetAsync("core", "helpdesk_title") ?? "RapidsolDestek";
}
<!doctype html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>@helpdeskTitle — @ViewData["Title"]</title>
<link rel="icon" href="~/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="~/css/base.css">
<link rel="stylesheet" href="~/css/portal.css">
<link rel="stylesheet" href="~/css/admin.css">
<link rel="stylesheet" href="~/css/app.css">
<script src="~/js/rd.js" defer></script>
</head>
<body class="backoffice" data-panel="@panel" data-nav="@ViewData["NavKey"]"
      data-toast="@ViewData["Toast"]" data-toast-variant="@ViewData["ToastVariant"]"
      data-editor-font="@SL["editor.font"]" data-editor-size="@SL["editor.size"]">

<div id="rd-topbar">
    <partial name="_BackofficeTopbar" model="panel" />
</div>
<div id="rd-sidebar">
    <partial name="_BackofficeSidebar" model="panel" />
</div>

@* Per-page main style (ticket-open mockup carries style="max-width:880px" on
   <main>); Razor omits the attribute entirely when no page sets MainStyle. *@
<main class="bo-main" style="@(ViewData["MainStyle"] as string)">
    @RenderBody()
</main>

</body>
</html>
