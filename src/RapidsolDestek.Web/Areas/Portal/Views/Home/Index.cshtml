@using System.Globalization
@model RapidsolDestek.Web.Areas.Portal.Controllers.HomeVm
@{
    ViewData["Title"] = SL["nav.home"];

    // Mockup pill classes exist for open/wait/test/solved/closed; derived and
    // internal keys map onto them (effortWait→wait per portal/index.html, new→open).
    static string StatusClass(string key) => key switch
    {
        "effortWait" => "rc-status-wait",
        "new" => "rc-status-open",
        "open" or "wait" or "test" or "solved" or "closed" => $"rc-status-{key}",
        _ => "rc-status-open",
    };

    // Table-cell agent name convention (§2 canon): "Ümit Yaşar Akın" → "Ümit Y. Akın".
    static string ShortName(string? full)
    {
        if (string.IsNullOrWhiteSpace(full))
            return "—";
        var parts = full.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length < 3)
            return full;
        var middles = string.Join(" ", parts[1..^1].Select(p => $"{char.ToUpperInvariant(p[0])}."));
        return $"{parts[0]} {middles} {parts[^1]}";
    }
}

<div class="rc-hero">
    <div>
        <h1>@L["home.welcome"]</h1>
        <p>@L["home.sub"]</p>
    </div>
    <a class="rc-button-primary" href="/open">@L["home.newBtn"]</a>
</div>

<div class="rc-summary">
    <div class="rc-summary-item">
        <div class="rc-summary-label">@L["home.statOpen"]</div>
        <div class="rc-summary-value">@Model.OpenCount</div>
        <div class="rc-summary-note">@L["home.statOpenNote", Model.InProgressCount]</div>
    </div>
    <div class="rc-summary-item">
        <div class="rc-summary-label">@L["home.statWaiting"]</div>
        <div class="rc-summary-value">@Model.WaitingCount</div>
        <div class="rc-summary-note">@L["home.statWaitingNote"]</div>
    </div>
    <div class="rc-summary-item">
        <div class="rc-summary-label">@L["home.statClosed"]</div>
        <div class="rc-summary-value">@Model.SolvedThisMonth</div>
        <div class="rc-summary-note">@L["home.statClosedNote"]</div>
    </div>
    <div class="rc-summary-item">
        <div class="rc-summary-label">@L["home.statCancelled"]</div>
        <div class="rc-summary-value">@Model.CancelledThisMonth</div>
        <div class="rc-summary-note">@L["home.statCancelledNote"]</div>
    </div>
</div>

<div class="rc-columns">
    <div class="rc-surface">
        <div class="rc-surface-head">
            <span>@L["home.recent"]</span>
            <a class="more" href="/tickets">@L["home.viewAll"]</a>
        </div>
        @foreach (var t in Model.Recent)
        {
            var updated = t.UpdatedAt.ToLocalTime();
            var today = DateTime.Now.Date;
            var meta = updated.Date == today
                ? L["meta.updToday", updated.ToString("HH:mm")]
                : updated.Date == today.AddDays(-1)
                    ? L["meta.updYesterday", updated.ToString("HH:mm")]
                    : L["meta.updOn", updated.ToString("m", CultureInfo.CurrentUICulture)];
            <a class="rc-ticket-row" href="/ticket-view?id=@t.Id">
                <div class="rc-ticket-id">@t.Number</div>
                <div>
                    <div class="rc-ticket-title">@t.Subject</div>
                    <div class="rc-ticket-meta">@meta</div>
                </div>
                <div class="rc-status @StatusClass(t.StatusKey)">@(t.StatusKey == "effortWait" ? L["status.effortWait"] : SL[$"status.{t.StatusKey}"])</div>
                <div>@ShortName(t.AgentName)</div>
            </a>
        }
    </div>

    <aside>
        <div class="rc-surface">
            <div class="rc-surface-head">@L["home.process"]</div>
            <div class="rc-steps">
                <div class="rc-step">
                    <span class="rc-step-icon">1</span>
                    <div><b>@L["home.step1"]</b><small>@L["home.step1Sub"]</small></div>
                </div>
                <div class="rc-step">
                    <span class="rc-step-icon">2</span>
                    <div><b>@L["home.step2"]</b><small>@L["home.step2Sub"]</small></div>
                </div>
                <div class="rc-step">
                    <span class="rc-step-icon">3</span>
                    <div><b>@L["home.step3"]</b><small>@L["home.step3Sub"]</small></div>
                </div>
            </div>
        </div>

        <div class="rc-surface" style="margin-top:14px">
            <div class="rc-surface-head">@L["home.kbTitle"]</div>
            <div class="rc-aside-block">
                <p class="rd-help" style="margin:0 0 12px">@L["home.kbSub"]</p>
                <form method="get" action="/kb">
                    <input class="rc-control" type="search" name="q" placeholder="@L["home.kbPlaceholder"]">
                </form>
                <div class="rc-notice"><a href="/kb">@SL["nav.kb"]</a> →</div>
            </div>
        </div>
    </aside>
</div>
