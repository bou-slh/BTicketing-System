@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["cs.title"];
}
@* TODO(S5): guest lookup posts and returns an access-link result; page then gets the anonymous portal header. *@
<div class="rc-auth-card" style="margin:40px auto">
    <h1>@L["cs.title"]</h1>
    <p>@L["cs.sub"]</p>

    <form method="post" class="rc-form-grid">
        <div>
            <label class="rc-label" for="cs-email">@L["cs.email"]</label>
            <input id="cs-email" class="rc-control" type="email" autocomplete="email">
        </div>
        <div>
            <label class="rc-label" for="cs-ticket">@L["cs.ticket"]</label>
            <input id="cs-ticket" class="rc-control" type="text" placeholder="@L["cs.ticketPh"]">
            <div class="rd-help">@L["cs.ticketHelp"]</div>
        </div>
        <button type="submit" class="rc-button-primary" style="justify-content:center">@L["cs.submit"]</button>
        <div class="rc-notice">@L["cs.note"]</div>
    </form>

    <div class="rc-auth-foot">
        <span>@L["cs.haveAccount"]</span>
        <a href="/login">@L["cs.signin"]</a>
    </div>
</div>
