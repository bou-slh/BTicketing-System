@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["of.title"];
}
<div class="rc-auth-card" style="text-align:center">
    <a class="rc-logo" href="/" style="justify-content:center;margin-bottom:20px">
        <span class="rc-logo-mark"></span><span>RAPID<span class="rc-logo-accent">SOL</span></span>
    </a>
    <div style="font-size:48px;margin-bottom:14px" aria-hidden="true">🛠</div>
    <h1>@L["of.title"]</h1>
    <p>@L["of.text"]</p>
    <div class="rc-notice">
        <span>@L["of.mail"]</span>
        <a href="mailto:destek@rapidsol.com.tr">destek@rapidsol.com.tr</a>
    </div>
</div>
