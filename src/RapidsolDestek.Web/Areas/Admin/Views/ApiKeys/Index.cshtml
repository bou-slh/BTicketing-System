@using System.Globalization
@using RapidsolDestek.Web.Areas.Admin.Controllers
@model ApiKeysIndexVm
@{
    ViewData["Title"] = L["ak.title"];

    // PRG toast handoff after create/update/regenerate/bulk (SLA precedent).
    if (TempData["ApiKeysToast"] is string toastKey)
    {
        var ok = TempData["ApiKeysToastOk"] as int? ?? 0;
        ViewData["Toast"] = toastKey is "ak.bulkDone"
            ? L.GetString(toastKey, ok)
            : L[toastKey].Value;
        if (TempData["ApiKeysToastError"] is not null)
        {
            ViewData["ToastVariant"] = "error";
        }
    }

    // Updated cell: the mockup's "4 Ağu 2026" cells (ak.dateFmt).
    string UpdatedText(DateTimeOffset value) =>
        value.ToLocalTime().ToString(L.GetString("ak.dateFmt"), CultureInfo.CurrentUICulture);

    // Canonical querystring builder so header sort / pagination preserve state.
    string BuildUrl(string? sortOver = null, string? dirOver = null, int? pageOver = null)
    {
        var parts = new List<string>();
        void Add(string k, string? v)
        {
            if (!string.IsNullOrEmpty(v))
                parts.Add($"{k}={Uri.EscapeDataString(v)}");
        }
        Add("q", Model.Query);
        Add("sort", sortOver ?? Model.Sort);
        Add("dir", dirOver ?? (Model.Desc ? "desc" : "asc"));
        if (pageOver is { } pg && pg > 1)
            Add("page", pg.ToString());
        return "/admin/apikeys" + (parts.Count > 0 ? "?" + string.Join("&", parts) : "");
    }
    string SortUrl(string key) => Model.Sort == key
        ? BuildUrl(sortOver: key, dirOver: Model.Desc ? "asc" : "desc")
        : BuildUrl(sortOver: key, dirOver: key == "updated" ? "desc" : "asc");
    string SortClass(string key) => Model.Sort != key ? "sortable" : Model.Desc ? "sortable sorted-desc" : "sortable sorted-asc";
    var currentUrl = BuildUrl(pageOver: Model.Page);
    var mono = "font-family:ui-monospace,SFMono-Regular,Menlo,monospace";
}

<div class="bo-page-head">
    <div>
        <h1>@L["ak.title"]</h1>
        <p>@L["ak.sub"]</p>
    </div>
</div>

<form class="rd-list-toolbar" method="get" action="/admin/apikeys">
    <input type="hidden" name="sort" value="@Model.Sort">
    <input type="hidden" name="dir" value="@(Model.Desc ? "desc" : "asc")">
    <input type="search" class="rd-control" name="q" value="@Model.Query" placeholder="@L["ak.searchPh"]">
    <span class="spacer"></span>
    <button class="rd-btn" type="button" data-dialog-open="dlg-more"><span>@SL["common.more"]</span> ▾</button>
    <button class="rd-btn rd-btn-primary" type="button" data-dialog-open="dlg-key">@L["ak.new"]</button>
</form>

<div class="rd-surface" id="tbl-keys">
    @if (Model.Rows.Count == 0)
    {
        @* Mockup's hidden #ak-empty panel, reachable for real (B1). *@
        <div class="rd-empty">
            <div class="icon">⚿</div>
            <h3>@L["ak.emptyTitle"]</h3>
            <p>@L["ak.emptyText"]</p>
            <button class="rd-btn rd-btn-primary" type="button" data-dialog-open="dlg-key">@L["ak.new"]</button>
        </div>
    }
    else
    {
    <div style="overflow-x:auto">
        <table class="rd-table">
            <thead>
                <tr>
                    <th class="col-check"><input type="checkbox" data-check-all="#tbl-keys" title="@SL["common.selectAll"]"></th>
                    <th>@L["ak.colKey"]</th>
                    <th class="@SortClass("ip")"><a href="@SortUrl("ip")">@L["ak.colIp"]</a></th>
                    <th>@SL["common.status"]</th>
                    <th>@L["ak.colServices"]</th>
                    <th class="@SortClass("updated")"><a href="@SortUrl("updated")">@SL["common.updated"]</a></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td class="col-check"><input type="checkbox" name="ids" value="@r.Id" form="ak-bulk"></td>
                        <td><a href="#" data-dialog-open="dlg-key-@r.Id" style="@mono">@r.KeyDisplay</a></td>
                        <td>@r.IpAddress</td>
                        @if (r.IsActive)
                        {
                            <td><span class="rd-pill rd-pill-solved">@SL["common.active"]</span></td>
                        }
                        else
                        {
                            <td><span class="rd-pill rd-pill-closed">@SL["common.disabled"]</span></td>
                        }
                        <td>
                            @if (r.CanCreateTickets)
                            {
                                <span class="rd-pill rd-pill-teal">@L["ak.svcTickets"]</span>
                            }
                            @if (r.CanTriggerJobs)
                            {
                                <span class="rd-pill rd-pill-open">@L["ak.svcCron"]</span>
                            }
                        </td>
                        <td>@UpdatedText(r.Updated)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="rd-pagination">
        <span>@L["ak.showing", Model.From, Model.To, Model.Total]</span>
        <div class="pages">
            @for (var p = 1; p <= Model.PageCount; p++)
            {
                if (p == Model.Page)
                {
                    <span class="current">@p</span>
                }
                else
                {
                    <a href="@BuildUrl(pageOver: p)">@p</a>
                }
            }
        </div>
    </div>
    }
</div>

@* Selection carrier for the dlg-more bulk actions (SLA precedent). *@
<form id="ak-bulk" method="post" asp-area="Admin" asp-controller="ApiKeys" asp-action="Bulk" hidden>
    <input type="hidden" name="returnUrl" value="@currentUrl">
</form>

@* Per-row regenerate carriers: the dialog's regenerate button posts here via its
   form attribute (nested forms are invalid HTML). *@
@foreach (var r in Model.Rows)
{
    <form id="ak-regen-@r.Id" method="post" asp-area="Admin" asp-controller="ApiKeys" asp-action="Regenerate" hidden>
        <input type="hidden" name="id" value="@r.Id">
        <input type="hidden" name="returnUrl" value="@currentUrl">
    </form>
}

@* Key dialog: one create instance (dlg-key, server-pregenerated key) + per-row
   edit instances prefilled server-side (B2 — the mockup shares ONE hardcoded
   dlg-key between the new-button and all rows; split per the SLA precedent,
   flagged). Copy + regenerate buttons are INVENTED UI (ROADMAP row promises,
   mockup renders neither; flagged). *@
@{
    async Task KeyDialogAsync(string dialogId, ApiKeyRowVm? key)
    {
        <dialog class="rd-dialog" id="@dialogId">
            <form method="post" asp-area="Admin" asp-controller="ApiKeys"
                  asp-action="@(key is null ? "Create" : "Update")">
                @if (key is not null)
                {
                    <input type="hidden" name="id" value="@key.Id">
                }
                <input type="hidden" name="returnUrl" value="@currentUrl">
                <div class="rd-dialog-head">
                    <span>@(key is null ? L["ak.dlgTitle"].Value : L["ak.dlgEditTitle"].Value)</span>
                    <button type="button" class="close" data-dialog-close>✕</button>
                </div>
                <div class="rd-dialog-body">
                    <div class="rd-field">
                        <label class="rd-label" for="ak-key-@dialogId">@L["ak.key"]</label>
                        <div style="display:flex;gap:8px;align-items:center">
                            <input id="ak-key-@dialogId" name="key" class="rd-control" readonly
                                   value="@(key?.Key ?? Model.NewKey)" style="@mono;background:var(--rd-gray-bg);flex:1">
                            <button type="button" class="rd-btn rd-btn-ghost rd-btn-sm"
                                    data-copy="#ak-key-@dialogId" data-copy-msg="@L["ak.copied"]">@L["ak.copy"]</button>
                            @if (key is not null)
                            {
                                <button type="submit" class="rd-btn rd-btn-ghost rd-btn-sm"
                                        form="ak-regen-@key.Id">@L["ak.regen"]</button>
                            }
                        </div>
                        <div class="rd-help">@L["ak.keyHelp"]</div>
                    </div>
                    <div class="rd-grid-2">
                        <div class="rd-field">
                            <label class="rd-label" for="ak-ip-@dialogId">@L["ak.ip"]</label>
                            <input id="ak-ip-@dialogId" name="ip" class="rd-control" value="@key?.IpAddress" required>
                            <div class="rd-help">@L["ak.ipHelp"]</div>
                        </div>
                        <div class="rd-field">
                            <span class="rd-label">@L["ak.status"]</span>
                            <div style="display:flex;gap:18px;padding:10px 0 2px">
                                <label class="rd-check"><input type="radio" name="active" value="true" checked="@(key?.IsActive ?? true)"><span>@SL["common.active"]</span></label>
                                <label class="rd-check"><input type="radio" name="active" value="false" checked="@(key is { IsActive: false })"><span>@SL["common.disabled"]</span></label>
                            </div>
                        </div>
                    </div>
                    <div class="rd-field">
                        <span class="rd-label">@L["ak.perms"]</span>
                        <div style="display:flex;flex-direction:column;gap:9px;padding-top:4px">
                            <label class="rd-check"><input type="checkbox" name="canTickets" value="true" checked="@(key?.CanCreateTickets ?? true)"><span>@L["ak.permTickets"]</span></label>
                            <label class="rd-check"><input type="checkbox" name="canJobs" value="true" checked="@(key is { CanTriggerJobs: true })"><span>@L["ak.permCron"]</span></label>
                        </div>
                    </div>
                    <div class="rd-field mb-0">
                        <label class="rd-label" for="ak-notes-@dialogId">@SL["common.notes"]</label>
                        <textarea id="ak-notes-@dialogId" name="notes" class="rd-control" style="min-height:70px">@key?.Notes</textarea>
                        <div class="rd-help">@SL["common.notesHelp"]</div>
                    </div>
                </div>
                <div class="rd-dialog-foot">
                    <button type="button" class="rd-btn" data-dialog-close>@SL["common.cancel"]</button>
                    @* No data-dialog-close on the submit — the audited B2 close-swallows-save bug. *@
                    <button type="submit" class="rd-btn rd-btn-primary">@SL["common.save"]</button>
                </div>
            </form>
        </dialog>
    }

    await KeyDialogAsync("dlg-key", null);
    foreach (var r in Model.Rows)
    {
        await KeyDialogAsync($"dlg-key-{r.Id}", r);
    }
}

<dialog class="rd-dialog" id="dlg-more">
    <div class="rd-dialog-head"><span>@L["ak.bulkTitle"]</span><button class="close" data-dialog-close>✕</button></div>
    <div class="rd-dialog-body">
        <p class="rd-help" style="margin-top:0">@L["ak.bulkHelp"]</p>
        <div style="display:flex;flex-direction:column;gap:9px;margin-top:12px">
            @* No data-dialog-close on the submits — the audited B2 close-swallows-save bug. *@
            <button class="rd-btn" type="submit" form="ak-bulk" name="act" value="enable">@SL["common.enable"]</button>
            <button class="rd-btn" type="submit" form="ak-bulk" name="act" value="disable">@SL["common.disable"]</button>
            <button class="rd-btn rd-btn-danger" type="button" data-dialog-open="dlg-delete" data-dialog-close>@SL["common.delete"]</button>
        </div>
    </div>
</dialog>

<dialog class="rd-dialog" id="dlg-delete">
    <div class="rd-dialog-head"><span>@SL["common.delete"]</span><button class="close" data-dialog-close>✕</button></div>
    <div class="rd-dialog-body"><p>@SL["common.confirmDelete"]</p></div>
    <div class="rd-dialog-foot">
        <button class="rd-btn" type="button" data-dialog-close>@SL["common.cancel"]</button>
        <button class="rd-btn rd-btn-danger" type="submit" form="ak-bulk" name="act" value="delete">@SL["common.delete"]</button>
    </div>
</dialog>
