@using System.Globalization
@using RapidsolDestek.Domain.Entities
@using RapidsolDestek.Web.Areas.Admin.Controllers
@model PagesIndexVm
@{
    ViewData["Title"] = L["pg.title"];

    // PRG toast handoff after create/update/bulk (SLA precedent).
    if (TempData["PagesToast"] is string toastKey)
    {
        var ok = TempData["PagesToastOk"] as int? ?? 0;
        var skipped = TempData["PagesToastSkipped"] as int? ?? 0;
        ViewData["Toast"] = toastKey is "pg.bulkDone" or "pg.bulkPartial"
            ? L.GetString(toastKey, ok, skipped)
            : L[toastKey].Value;
        if (TempData["PagesToastError"] is not null)
        {
            ViewData["ToastVariant"] = "error";
        }
    }

    // Updated cell: the mockup's "12 Tem 2026" cells (pg.dateFmt).
    string UpdatedText(DateTimeOffset value) =>
        value.ToLocalTime().ToString(L.GetString("pg.dateFmt"), CultureInfo.CurrentUICulture);

    string TypeLabel(SitePageType type) => type switch
    {
        SitePageType.Landing => L["pg.typeLanding"].Value,
        SitePageType.Offline => L["pg.typeOffline"].Value,
        SitePageType.ThankYou => L["pg.typeThanks"].Value,
        _ => L["pg.typeOther"].Value,
    };

    // Canonical querystring builder so header sort / pagination preserve state.
    string BuildUrl(string? sortOver = null, string? dirOver = null, int? pageOver = null)
    {
        var parts = new List<string>();
        void Add(string k, string? v)
        {
            if (!string.IsNullOrEmpty(v))
                parts.Add($"{k}={Uri.EscapeDataString(v)}");
        }
        Add("q", Model.Query);
        Add("sort", sortOver ?? Model.Sort);
        Add("dir", dirOver ?? (Model.Desc ? "desc" : "asc"));
        if (pageOver is { } pg && pg > 1)
            Add("page", pg.ToString());
        return "/admin/pages" + (parts.Count > 0 ? "?" + string.Join("&", parts) : "");
    }
    string SortUrl(string key) => Model.Sort == key
        ? BuildUrl(sortOver: key, dirOver: Model.Desc ? "asc" : "desc")
        : BuildUrl(sortOver: key, dirOver: key == "updated" ? "desc" : "asc");
    string SortClass(string key) => Model.Sort != key ? "sortable" : Model.Desc ? "sortable sorted-desc" : "sortable sorted-asc";
    var currentUrl = BuildUrl(pageOver: Model.Page);
}

<div class="bo-page-head">
    <div>
        <h1>@L["pg.title"]</h1>
        <p>@L["pg.sub"]</p>
    </div>
</div>

<form class="rd-list-toolbar" method="get" action="/admin/pages">
    <input type="hidden" name="sort" value="@Model.Sort">
    <input type="hidden" name="dir" value="@(Model.Desc ? "desc" : "asc")">
    <input type="search" class="rd-control" name="q" value="@Model.Query" placeholder="@L["pg.searchPh"]">
    <span class="spacer"></span>
    <button class="rd-btn" type="button" data-dialog-open="dlg-more"><span>@SL["common.more"]</span> ▾</button>
    <button class="rd-btn rd-btn-primary" type="button" data-dialog-open="dlg-page">@L["pg.new"]</button>
</form>

<div class="rd-surface" id="tbl-pages">
    @if (Model.Rows.Count == 0)
    {
        @* Mockup's hidden #pg-empty panel, reachable for real (B1). *@
        <div class="rd-empty">
            <div class="icon">❐</div>
            <h3>@L["pg.emptyTitle"]</h3>
            <p>@L["pg.emptyText"]</p>
            <button class="rd-btn rd-btn-primary" type="button" data-dialog-open="dlg-page">@L["pg.new"]</button>
        </div>
    }
    else
    {
    <div style="overflow-x:auto">
        <table class="rd-table">
            <thead>
                <tr>
                    <th class="col-check"><input type="checkbox" data-check-all="#tbl-pages" title="@SL["common.selectAll"]"></th>
                    <th class="@SortClass("name")"><a href="@SortUrl("name")">@SL["common.name"]</a></th>
                    <th>@L["pg.colType"]</th>
                    <th>@SL["common.status"]</th>
                    <th class="@SortClass("updated")"><a href="@SortUrl("updated")">@SL["common.updated"]</a></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td class="col-check"><input type="checkbox" name="ids" value="@r.Id" form="pg-bulk"></td>
                        <td><a href="#" data-dialog-open="dlg-page-@r.Id">@r.Name</a></td>
                        <td>@TypeLabel(r.Type)</td>
                        @if (r.IsActive)
                        {
                            <td><span class="rd-pill rd-pill-solved">@SL["common.active"]</span></td>
                        }
                        else
                        {
                            <td><span class="rd-pill rd-pill-closed">@SL["common.disabled"]</span></td>
                        }
                        <td>@UpdatedText(r.Updated)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="rd-pagination">
        <span>@L["pg.showing", Model.From, Model.To, Model.Total]</span>
        <div class="pages">
            @for (var p = 1; p <= Model.PageCount; p++)
            {
                if (p == Model.Page)
                {
                    <span class="current">@p</span>
                }
                else
                {
                    <a href="@BuildUrl(pageOver: p)">@p</a>
                }
            }
        </div>
    </div>
    }
</div>

@* Selection carrier for the dlg-more bulk actions (SLA precedent). *@
<form id="pg-bulk" method="post" asp-area="Admin" asp-controller="Pages" asp-action="Bulk" hidden>
    <input type="hidden" name="returnUrl" value="@currentUrl">
</form>

@* Page dialog: one create instance (dlg-page, empty) + per-row edit instances
   prefilled server-side (B2 — the mockup shares ONE hardcoded dlg-page between the
   new-button and all rows; split per the SLA precedent, flagged). *@
@{
    async Task PageDialogAsync(string dialogId, PageRowVm? pg)
    {
        <dialog class="rd-dialog" id="@dialogId">
            <form method="post" asp-area="Admin" asp-controller="Pages"
                  asp-action="@(pg is null ? "Create" : "Update")">
                @if (pg is not null)
                {
                    <input type="hidden" name="id" value="@pg.Id">
                }
                <input type="hidden" name="returnUrl" value="@currentUrl">
                <div class="rd-dialog-head">
                    <span>@L["pg.dlgTitle"]</span>
                    <button type="button" class="close" data-dialog-close>✕</button>
                </div>
                <div class="rd-dialog-body">
                    <div class="rd-field">
                        <label class="rd-label" for="pg-name-@dialogId">@L["pg.name"]</label>
                        <input id="pg-name-@dialogId" name="name" class="rd-control" value="@pg?.Name" required maxlength="120">
                        <div class="rd-help">@L["pg.nameHelp"]</div>
                    </div>
                    <div class="rd-grid-2">
                        <div class="rd-field">
                            <label class="rd-label" for="pg-type-@dialogId">@L["pg.type"]</label>
                            <select id="pg-type-@dialogId" name="type" class="rd-control">
                                <option value="landing" selected="@(pg is { Type: SitePageType.Landing })">@L["pg.typeLanding"]</option>
                                <option value="offline" selected="@(pg is { Type: SitePageType.Offline })">@L["pg.typeOffline"]</option>
                                <option value="thanks" selected="@(pg is { Type: SitePageType.ThankYou })">@L["pg.typeThanks"]</option>
                                <option value="other" selected="@(pg is null or { Type: SitePageType.Other })">@L["pg.typeOther"]</option>
                            </select>
                            <div class="rd-help">@L["pg.typeHelp"]</div>
                        </div>
                        <div class="rd-field">
                            <span class="rd-label">@L["pg.status"]</span>
                            <div style="display:flex;gap:18px;padding:10px 0 2px">
                                <label class="rd-check"><input type="radio" name="active" value="true" checked="@(pg?.IsActive ?? true)"><span>@SL["common.active"]</span></label>
                                <label class="rd-check"><input type="radio" name="active" value="false" checked="@(pg is { IsActive: false })"><span>@SL["common.disabled"]</span></label>
                            </div>
                        </div>
                    </div>
                    <div class="rd-field mb-0">
                        <label class="rd-label" for="pg-content-@dialogId">@L["pg.content"]</label>
                        <textarea id="pg-content-@dialogId" name="content" class="rd-control" style="min-height:140px" required>@pg?.Body</textarea>
                        <div class="rd-help">@L["pg.contentHelp"]</div>
                    </div>
                </div>
                <div class="rd-dialog-foot">
                    <button type="button" class="rd-btn" data-dialog-close>@SL["common.cancel"]</button>
                    @* No data-dialog-close on the submit — the audited B2 close-swallows-save bug. *@
                    <button type="submit" class="rd-btn rd-btn-primary">@SL["common.save"]</button>
                </div>
            </form>
        </dialog>
    }

    await PageDialogAsync("dlg-page", null);
    foreach (var r in Model.Rows)
    {
        await PageDialogAsync($"dlg-page-{r.Id}", r);
    }
}

<dialog class="rd-dialog" id="dlg-more">
    <div class="rd-dialog-head"><span>@L["pg.bulkTitle"]</span><button class="close" data-dialog-close>✕</button></div>
    <div class="rd-dialog-body">
        <p class="rd-help" style="margin-top:0">@L["pg.bulkHelp"]</p>
        <div style="display:flex;flex-direction:column;gap:9px;margin-top:12px">
            @* No data-dialog-close on the submits — the audited B2 close-swallows-save bug. *@
            <button class="rd-btn" type="submit" form="pg-bulk" name="act" value="enable">@SL["common.enable"]</button>
            <button class="rd-btn" type="submit" form="pg-bulk" name="act" value="disable">@SL["common.disable"]</button>
            <button class="rd-btn rd-btn-danger" type="button" data-dialog-open="dlg-delete" data-dialog-close>@SL["common.delete"]</button>
        </div>
    </div>
</dialog>

<dialog class="rd-dialog" id="dlg-delete">
    <div class="rd-dialog-head"><span>@SL["common.delete"]</span><button class="close" data-dialog-close>✕</button></div>
    <div class="rd-dialog-body"><p>@SL["common.confirmDelete"]</p></div>
    <div class="rd-dialog-foot">
        <button class="rd-btn" type="button" data-dialog-close>@SL["common.cancel"]</button>
        <button class="rd-btn rd-btn-danger" type="submit" form="pg-bulk" name="act" value="delete">@SL["common.delete"]</button>
    </div>
</dialog>
