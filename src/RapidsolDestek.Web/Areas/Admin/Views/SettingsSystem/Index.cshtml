@using RapidsolDestek.Web.Areas.Admin.Controllers
@model SettingsSystemVm
@{
    ViewData["Title"] = L["ss.title"];

    // Toast handoff (settings-tickets precedent): PRG keys via TempData.
    if (TempData["SsToast"] is string toastKey)
    {
        ViewData["Toast"] = L[toastKey].Value;
        if (TempData["SsToastError"] is not null)
        {
            ViewData["ToastVariant"] = "error";
        }
    }
}

<div class="bo-page-head">
    <div>
        <h1>@L["ss.title"]</h1>
        <p>@L["ss.subtitle"]</p>
    </div>
</div>

<div class="bo-settings">
    <nav class="bo-section-index" aria-label="Sections">
        <a href="#sec-general" class="active">@L["ss.secGeneral"]</a>
        <a href="#sec-datetime">@L["ss.secDatetime"]</a>
        <a href="#sec-lang">@L["ss.secLang"]</a>
        <a href="#sec-attach">@L["ss.secAttach"]</a>
    </nav>

    <form class="bo-settings-sections" method="post" asp-area="Admin" asp-controller="SettingsSystem" asp-action="Save">

        <section class="rd-surface bo-section" id="sec-general">
            <div class="rd-surface-head"><span>@L["ss.secGeneral"]</span></div>
            <div class="rd-surface-body">
                <div class="rd-field">
                    <label class="rd-switch">
                        @* LIVE: reads/writes the SAME system/offline Setting the S5
                           MaintenanceModeMiddleware serves portal/offline.html from
                           (inverted: online ⇔ !offline). Agents keep working. *@
                        <input type="checkbox" name="online" value="true" checked="@Model.Online">
                        <span class="track"></span>
                        <span class="rd-switch-copy">
                            <b>@L["ss.online"]</b>
                            <small>@L["ss.onlineHelp"]</small>
                        </span>
                    </label>
                </div>
                <div class="rd-field">
                    <label class="rd-label" for="sys-url">@L["ss.url"]</label>
                    <input id="sys-url" class="rd-control" type="url" name="helpdesk_url" value="@Model.HelpdeskUrl" required>
                    <div class="rd-help">@L["ss.urlHelp"]</div>
                </div>
                <div class="rd-field">
                    <label class="rd-label" for="sys-name">@L["ss.name"]</label>
                    <input id="sys-name" class="rd-control" name="helpdesk_title" value="@Model.HelpdeskTitle" required>
                    <div class="rd-help">@L["ss.nameHelp"]</div>
                </div>
                <div class="rd-field">
                    <label class="rd-label" for="sys-dept">@L["ss.defaultDept"]</label>
                    <select id="sys-dept" class="rd-control" name="default_dept">
                        @foreach (var dept in Model.Departments)
                        {
                            <option value="@dept.Id" selected="@(Model.DefaultDeptId == dept.Id)">@dept.Label</option>
                        }
                    </select>
                    <div class="rd-help">@L["ss.defaultDeptHelp"]</div>
                </div>

                <details class="rd-advanced">
                    <summary>@SL["common.advanced"]</summary>
                    <div class="rd-advanced-body">
                        <div class="rd-field">
                            <label class="rd-switch">
                                <input type="checkbox" name="force_https" value="true" checked="@Model.ForceHttps">
                                <span class="track"></span>
                                <span class="rd-switch-copy">
                                    <b>@L["ss.forceHttps"]</b>
                                    <small>@L["ss.forceHttpsHelp"]</small>
                                </span>
                            </label>
                        </div>
                        <div class="rd-grid-2">
                            <div class="rd-field">
                                <label class="rd-label" for="sys-collision">@L["ss.collision"]</label>
                                <input id="sys-collision" class="rd-control" type="number" min="1" name="collision" value="@Model.CollisionMinutes">
                                <div class="rd-help">@L["ss.collisionHelp"]</div>
                            </div>
                            <div class="rd-field">
                                <label class="rd-label" for="sys-pagesize">@L["ss.pageSize"]</label>
                                <select id="sys-pagesize" class="rd-control" name="page_size">
                                    @foreach (var size in new[] { 10, 25, 50, 100 })
                                    {
                                        <option value="@size" selected="@(Model.PageSize == size)">@size</option>
                                    }
                                </select>
                                <div class="rd-help">@L["ss.pageSizeHelp"]</div>
                            </div>
                        </div>
                        <div class="rd-grid-2">
                            <div class="rd-field">
                                <label class="rd-label" for="sys-loglevel">@L["ss.logLevel"]</label>
                                <select id="sys-loglevel" class="rd-control" name="log_level">
                                    <option value="none" selected="@(Model.LogLevel == "none")">@L["ss.logNone"]</option>
                                    <option value="error" selected="@(Model.LogLevel == "error")">@L["ss.logError"]</option>
                                    <option value="warn" selected="@(Model.LogLevel == "warn")">@L["ss.logWarn"]</option>
                                    <option value="debug" selected="@(Model.LogLevel == "debug")">@L["ss.logDebug"]</option>
                                </select>
                                <div class="rd-help">@L["ss.logLevelHelp"]</div>
                            </div>
                            <div class="rd-field">
                                <label class="rd-label" for="sys-logpurge">@L["ss.logPurge"]</label>
                                <select id="sys-logpurge" class="rd-control" name="log_purge">
                                    <option value="0" selected="@(Model.LogPurgeMonths == 0)">@L["ss.purgeNever"]</option>
                                    <option value="1" selected="@(Model.LogPurgeMonths == 1)">@L["ss.purge1m"]</option>
                                    <option value="3" selected="@(Model.LogPurgeMonths == 3)">@L["ss.purge3m"]</option>
                                    <option value="6" selected="@(Model.LogPurgeMonths == 6)">@L["ss.purge6m"]</option>
                                    <option value="12" selected="@(Model.LogPurgeMonths == 12)">@L["ss.purge12m"]</option>
                                </select>
                                <div class="rd-help">@L["ss.logPurgeHelp"]</div>
                            </div>
                        </div>
                        <div class="rd-field">
                            <label class="rd-switch">
                                <input type="checkbox" name="avatars" value="true" checked="@Model.ShowAvatars">
                                <span class="track"></span>
                                <span class="rd-switch-copy">
                                    <b>@L["ss.avatars"]</b>
                                    <small>@L["ss.avatarsHelp"]</small>
                                </span>
                            </label>
                        </div>
                        <div class="rd-field">
                            <label class="rd-switch">
                                <input type="checkbox" name="richtext" value="true" checked="@Model.RichText">
                                <span class="track"></span>
                                <span class="rd-switch-copy">
                                    <b>@L["ss.richtext"]</b>
                                    <small>@L["ss.richtextHelp"]</small>
                                </span>
                            </label>
                        </div>
                        <div class="rd-field">
                            <label class="rd-label" for="sys-iframe">@L["ss.iframeList"]</label>
                            <input id="sys-iframe" class="rd-control" name="iframe_list" value="@Model.IframeAllowlist" placeholder="https://intranet.rapidsol.com.tr">
                            <div class="rd-help">@L["ss.iframeListHelp"]</div>
                        </div>
                        <div class="rd-field">
                            <label class="rd-label" for="sys-embed">@L["ss.embedList"]</label>
                            <input id="sys-embed" class="rd-control" name="embed_list" value="@Model.EmbedAllowlist" placeholder="youtube.com, vimeo.com">
                            <div class="rd-help">@L["ss.embedListHelp"]</div>
                        </div>
                        <div class="rd-field">
                            <label class="rd-label" for="sys-acl">@L["ss.acl"]</label>
                            <input id="sys-acl" class="rd-control" name="acl_ips" value="@Model.AclIps" placeholder="10.0.4.0/24, 88.243.17.90">
                            <div class="rd-help">@L["ss.aclHelp"]</div>
                        </div>
                        <div class="rd-field mb-0">
                            <label class="rd-label" for="sys-acl-backend">@L["ss.aclBackend"]</label>
                            <select id="sys-acl-backend" class="rd-control" name="acl_scope">
                                <option value="admin" selected="@(Model.AclScope == "admin")">@L["ss.aclAdmin"]</option>
                                <option value="staff" selected="@(Model.AclScope == "staff")">@L["ss.aclStaff"]</option>
                                <option value="all" selected="@(Model.AclScope == "all")">@L["ss.aclAll"]</option>
                            </select>
                            <div class="rd-help">@L["ss.aclBackendHelp"]</div>
                        </div>
                    </div>
                </details>
            </div>
        </section>

        <section class="rd-surface bo-section" id="sec-datetime">
            <div class="rd-surface-head"><span>@L["ss.secDatetime"]</span></div>
            <div class="rd-surface-body">
                <div class="rd-field">
                    <label class="rd-label" for="dt-locale">@L["ss.locale"]</label>
                    <select id="dt-locale" class="rd-control" name="locale">
                        @foreach (var code in new[] { "tr-TR", "en-US", "en-GB" })
                        {
                            <option value="@code" selected="@(Model.Locale == code)">@SettingsSystemController.LocaleLabel(code)</option>
                        }
                    </select>
                    <div class="rd-help">@L["ss.localeHelp"]</div>
                </div>
                <div class="rd-field">
                    <label class="rd-label" for="dt-tz">@L["ss.timezone"]</label>
                    <select id="dt-tz" class="rd-control" name="timezone">
                        @foreach (var tz in new[] { "Europe/Istanbul", "UTC", "Europe/Berlin" })
                        {
                            <option value="@tz" selected="@(Model.Timezone == tz)">@SettingsSystemController.TimezoneLabel(tz)</option>
                        }
                    </select>
                    <div class="rd-help">@L["ss.timezoneHelp"]</div>
                </div>
                <div class="rd-field">
                    <label class="rd-label" for="dt-mode">@L["ss.timeFormatMode"]</label>
                    <select id="dt-mode" class="rd-control" name="time_format_mode">
                        <option value="locale" selected="@(Model.TimeFormatMode == "locale")">@L["ss.fmtLocale"]</option>
                        <option value="24h" selected="@(Model.TimeFormatMode == "24h")">@L["ss.fmt24"]</option>
                        <option value="advanced" selected="@(Model.TimeFormatMode == "advanced")">@L["ss.fmtAdvanced"]</option>
                    </select>
                    <div class="rd-help">@L["ss.timeFormatModeHelp"]</div>
                </div>

                <details class="rd-advanced">
                    <summary>@SL["common.advanced"]</summary>
                    <div class="rd-advanced-body">
                        <div class="rd-grid-2">
                            <div class="rd-field">
                                <label class="rd-label" for="dt-time">@L["ss.timeFormat"]</label>
                                <input id="dt-time" class="rd-control" name="format_time" value="@Model.TimeFormat">
                                <div class="rd-help">@L["ss.timeFormatHelp"]</div>
                            </div>
                            <div class="rd-field">
                                <label class="rd-label" for="dt-date">@L["ss.dateFormat"]</label>
                                <input id="dt-date" class="rd-control" name="format_date" value="@Model.DateFormat">
                                <div class="rd-help">@L["ss.dateFormatHelp"]</div>
                            </div>
                            <div class="rd-field">
                                <label class="rd-label" for="dt-datetime">@L["ss.datetimeFormat"]</label>
                                <input id="dt-datetime" class="rd-control" name="format_datetime" value="@Model.DateTimeFormat">
                                <div class="rd-help">@L["ss.datetimeFormatHelp"]</div>
                            </div>
                            <div class="rd-field">
                                <label class="rd-label" for="dt-day">@L["ss.dayFormat"]</label>
                                <input id="dt-day" class="rd-control" name="format_day" value="@Model.DayFormat">
                                <div class="rd-help">@L["ss.dayFormatHelp"]</div>
                            </div>
                        </div>
                        <div class="rd-field mb-0">
                            <label class="rd-label" for="dt-schedule">@L["ss.defaultSchedule"]</label>
                            <select id="dt-schedule" class="rd-control" name="default_schedule">
                                @foreach (var schedule in Model.Schedules)
                                {
                                    <option value="@schedule.Id" selected="@(Model.DefaultScheduleId == schedule.Id)">@schedule.Label</option>
                                }
                            </select>
                            <div class="rd-help">@L["ss.defaultScheduleHelp"]</div>
                            <a class="rd-btn rd-btn-ghost rd-btn-sm" style="margin-top:7px" href="/admin/schedules">@L["ss.manageSchedules"]</a>
                        </div>
                    </div>
                </details>
            </div>
        </section>

        <section class="rd-surface bo-section" id="sec-lang">
            <div class="rd-surface-head"><span>@L["ss.secLang"]</span></div>
            <div class="rd-surface-body">
                <div class="rd-field">
                    <label class="rd-label" for="lang-primary">@L["ss.primaryLang"]</label>
                    @* LIVE: the request-culture fallback when no cookie choice exists
                       (Program.cs CustomRequestCultureProvider). tr/en are the real cultures. *@
                    <select id="lang-primary" class="rd-control" name="primary_lang">
                        <option value="tr" selected="@(Model.PrimaryLanguage == "tr")">Türkçe</option>
                        <option value="en" selected="@(Model.PrimaryLanguage == "en")">English (United States)</option>
                    </select>
                    <div class="rd-help">@L["ss.primaryLangHelp"]</div>
                </div>
                <div class="rd-field mb-0">
                    <span class="rd-label">@L["ss.secondaryLangs"]</span>
                    @* B4 rows persisted as system/secondary_languages. Add/✕ round-trip
                       through the Languages endpoint (external form via the form=
                       attribute — the buttons sit inside the main settings form). *@
                    <div style="border:1px solid var(--rd-border);border-radius:11px;padding:6px 13px;margin-bottom:10px">
                        @foreach (var lang in Model.SecondaryLanguages)
                        {
                            <div style="display:flex;align-items:center;gap:10px;padding:8px 0">
                                <span>@lang.Name</span>
                                <span class="rd-pill rd-pill-teal">@lang.Code</span>
                                <button type="submit" form="f-langs" name="remove" value="@lang.Code"
                                        class="rd-btn rd-btn-ghost rd-btn-sm" style="margin-left:auto;color:var(--rd-red)"
                                        title="@L["ss.remove"]">✕</button>
                            </div>
                        }
                    </div>
                    <div class="bo-rule-row" style="margin-bottom:0">
                        <select class="rd-control" name="code" form="f-langs">
                            @foreach (var lang in Model.AddableLanguages)
                            {
                                <option value="@lang.Code">@lang.Name</option>
                            }
                        </select>
                        <button type="submit" form="f-langs" name="add" value="true" class="rd-btn">@L["ss.addLang"]</button>
                    </div>
                    <div class="rd-help">@L["ss.secondaryLangsHelp"]</div>
                </div>
            </div>
        </section>

        <section class="rd-surface bo-section" id="sec-attach">
            <div class="rd-surface-head"><span>@L["ss.secAttach"]</span></div>
            <div class="rd-surface-body">
                <div class="rd-field">
                    <label class="rd-label" for="att-storage">@L["ss.storage"]</label>
                    @* Persisted-only: only the "fs" IFileStore backend is registered;
                       DB truth renders (mockup's selected "Veritabanı" is sample state
                       — file contents never live in the database, see StoredFile). *@
                    <select id="att-storage" class="rd-control" name="storage">
                        <option value="db" selected="@(Model.Attachments.Storage == "db")">@L["ss.storageDb"]</option>
                        <option value="fs" selected="@(Model.Attachments.Storage == "fs")">@L["ss.storageDisk"]</option>
                        <option value="s3" selected="@(Model.Attachments.Storage == "s3")">@L["ss.storageS3"]</option>
                    </select>
                    <div class="rd-help">@L["ss.storageHelp"]</div>
                </div>
                <div class="rd-field">
                    <label class="rd-label" for="att-max">@L["ss.maxSize"]</label>
                    @* LIVE: enforced at every upload ingress (portal open/reply, agent
                       composers + ticket-open, kb-faq) — AttachmentSettings.MaxSizeBytes. *@
                    <select id="att-max" class="rd-control" name="max_size">
                        @foreach (var size in new[] { 1, 8, 16, 64 })
                        {
                            <option value="@size" selected="@(Model.Attachments.MaxSizeMb == size)">@size MB</option>
                        }
                    </select>
                    <div class="rd-help">@L["ss.maxSizeHelp"]</div>
                </div>
                <div class="rd-field mb-0">
                    <label class="rd-switch">
                        <input type="checkbox" name="auth_required" value="true" checked="@Model.Attachments.AuthRequired">
                        <span class="track"></span>
                        <span class="rd-switch-copy">
                            <b>@L["ss.authRequired"]</b>
                            <small>@L["ss.authRequiredHelp"]</small>
                        </span>
                    </label>
                </div>
            </div>
        </section>

        <div style="display:flex;gap:10px;justify-content:flex-end">
            <button type="reset" class="rd-btn">@SL["common.reset"]</button>
            <button type="submit" class="rd-btn rd-btn-primary">@SL["common.save"]</button>
        </div>
    </form>
</div>

@* Language add/remove round-trip form (B4). Lives outside the main settings form;
   the section's buttons and select bind to it via the form attribute. *@
<form id="f-langs" method="post" asp-area="Admin" asp-controller="SettingsSystem" asp-action="Languages"></form>
