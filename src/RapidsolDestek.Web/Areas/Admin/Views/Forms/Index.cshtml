@using System.Globalization
@using RapidsolDestek.Web.Areas.Admin.Controllers
@model FormsIndexVm
@{
    ViewData["Title"] = L["fm.title"];

    // PRG toast handoff after bulk/delete (slas/schedules precedent).
    if (TempData["FormsToast"] is string toastKey)
    {
        var ok = TempData["FormsToastOk"] as int? ?? 0;
        var skipped = TempData["FormsToastSkipped"] as int? ?? 0;
        @* GetString: LocalizedHtmlString.Value would return the UNFORMATTED resource. *@
        ViewData["Toast"] = toastKey is "fm.bulkDone" or "fm.bulkPartial"
            ? L.GetString(toastKey, ok, skipped).Value
            : L[toastKey].Value;
        if (TempData["FormsToastError"] is not null)
        {
            ViewData["ToastVariant"] = "error";
        }
    }

    // Date cells: the mockup's "4 Ağu 2026" format (fm.dateFmt).
    string DateText(DateTimeOffset value) =>
        value.ToLocalTime().ToString(L.GetString("fm.dateFmt"), CultureInfo.CurrentUICulture);

    string BuildUrl(string? sortOver = null, string? dirOver = null, int? pageOver = null)
    {
        var parts = new List<string>();
        void Add(string k, string? v)
        {
            if (!string.IsNullOrEmpty(v))
                parts.Add($"{k}={Uri.EscapeDataString(v)}");
        }
        Add("q", Model.Query);
        Add("sort", sortOver ?? Model.Sort);
        Add("dir", dirOver ?? (Model.Desc ? "desc" : "asc"));
        if (pageOver is { } pg && pg > 1)
            Add("page", pg.ToString());
        return "/admin/forms" + (parts.Count > 0 ? "?" + string.Join("&", parts) : "");
    }
    string SortUrl(string key) => Model.Sort == key
        ? BuildUrl(sortOver: key, dirOver: Model.Desc ? "asc" : "desc")
        : BuildUrl(sortOver: key, dirOver: key == "updated" ? "desc" : "asc");
    string SortClass(string key) => Model.Sort != key ? "sortable" : Model.Desc ? "sortable sorted-desc" : "sortable sorted-asc";
    var currentUrl = BuildUrl(pageOver: Model.Page);
}

<div class="bo-page-head">
    <div>
        <h1>@L["fm.title"]</h1>
        <p>@L["fm.sub"]</p>
    </div>
</div>

<form class="rd-list-toolbar" method="get" action="/admin/forms">
    <input type="hidden" name="sort" value="@Model.Sort">
    <input type="hidden" name="dir" value="@(Model.Desc ? "desc" : "asc")">
    <input type="search" class="rd-control" name="q" value="@Model.Query" placeholder="@L["fm.searchPh"]">
    <span class="spacer"></span>
    <button class="rd-btn" type="button" data-dialog-open="dlg-more"><span>@SL["common.more"]</span> ▾</button>
    <a class="rd-btn rd-btn-primary" href="/admin/form-edit">@L["fm.new"]</a>
</form>

@* Yerleşik formlar (IsSystem — undeletable, no selection column per the mockup). *@
<div class="rd-surface" style="margin-bottom:20px">
    <div class="rd-surface-head"><span>@L["fm.builtinHead"]</span></div>
    <table class="rd-table" id="tbl-builtin">
        <thead>
            <tr>
                <th class="@SortClass("name")"><a href="@SortUrl("name")">@SL["common.name"]</a></th>
                <th class="@SortClass("updated")"><a href="@SortUrl("updated")">@SL["common.updated"]</a></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Builtin)
            {
                <tr>
                    <td><a href="/admin/form-edit?id=@r.Id">@r.Title</a></td>
                    <td>@DateText(r.Updated)</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="rd-surface-body" style="border-top:1px solid var(--rd-border-soft);padding:12px 19px">
        <span class="rd-help">@L["fm.builtinHelp"]</span>
    </div>
</div>

@* Özel formlar *@
<div class="rd-surface" id="tbl-forms-wrap">
    <div class="rd-surface-head"><span>@L["fm.customHead"]</span></div>
    @if (Model.Custom.Count == 0)
    {
        @* Mockup's hidden #fm-empty panel, reachable for real (B1). *@
        <div class="rd-empty">
            <div class="icon">▤</div>
            <h3>@L["fm.emptyTitle"]</h3>
            <p>@L["fm.emptyText"]</p>
            <a class="rd-btn rd-btn-primary" href="/admin/form-edit">@L["fm.new"]</a>
        </div>
    }
    else
    {
    <table class="rd-table" id="tbl-forms">
        <thead>
            <tr>
                <th class="col-check"><input type="checkbox" data-check-all="#tbl-forms" title="@SL["common.selectAll"]"></th>
                <th class="@SortClass("name")"><a href="@SortUrl("name")">@SL["common.name"]</a></th>
                <th class="@SortClass("updated")"><a href="@SortUrl("updated")">@SL["common.updated"]</a></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Custom)
            {
                <tr>
                    <td class="col-check"><input type="checkbox" name="ids" value="@r.Id" form="fm-bulk"></td>
                    @* No status column in the mockup — bulk-disabled state is visible
                       only through the helptopic-edit attach list (schedules precedent). *@
                    <td><a href="/admin/form-edit?id=@r.Id">@r.Title</a></td>
                    <td>@DateText(r.Updated)</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="rd-surface-body" style="border-top:1px solid var(--rd-border-soft);padding:12px 19px">
        <span class="rd-help">@L["fm.customHelp"]</span>
    </div>
    <div class="rd-pagination">
        <span>@L["fm.showing", Model.From, Model.To, Model.Total]</span>
        <div class="pages">
            @for (var p = 1; p <= Model.PageCount; p++)
            {
                if (p == Model.Page)
                {
                    <span class="current">@p</span>
                }
                else
                {
                    <a href="@BuildUrl(pageOver: p)">@p</a>
                }
            }
        </div>
    </div>
    }
</div>

@* Selection carrier for the dlg-more bulk actions (slas precedent). *@
<form id="fm-bulk" method="post" asp-area="Admin" asp-controller="Forms" asp-action="Bulk" hidden>
    <input type="hidden" name="returnUrl" value="@currentUrl">
</form>

<dialog class="rd-dialog" id="dlg-more">
    <div class="rd-dialog-head"><span>@L["fm.bulkTitle"]</span><button class="close" data-dialog-close>✕</button></div>
    <div class="rd-dialog-body">
        <p class="rd-help" style="margin-top:0">@L["fm.bulkHelp"]</p>
        <div style="display:flex;flex-direction:column;gap:9px;margin-top:12px">
            @* No data-dialog-close on the submits — the audited B2 close-swallows-save bug. *@
            <button class="rd-btn" type="submit" form="fm-bulk" name="act" value="enable">@SL["common.enable"]</button>
            <button class="rd-btn" type="submit" form="fm-bulk" name="act" value="disable">@SL["common.disable"]</button>
            <button class="rd-btn rd-btn-danger" type="button" data-dialog-open="dlg-delete" data-dialog-close>@SL["common.delete"]</button>
        </div>
    </div>
</dialog>

<dialog class="rd-dialog" id="dlg-delete">
    <div class="rd-dialog-head"><span>@SL["common.delete"]</span><button class="close" data-dialog-close>✕</button></div>
    <div class="rd-dialog-body"><p>@SL["common.confirmDelete"]</p></div>
    <div class="rd-dialog-foot">
        <button class="rd-btn" type="button" data-dialog-close>@SL["common.cancel"]</button>
        <button class="rd-btn rd-btn-danger" type="submit" form="fm-bulk" name="act" value="delete">@SL["common.delete"]</button>
    </div>
</dialog>
