@using System.Globalization
@using RapidsolDestek.Web.Areas.Admin.Controllers
@model TemplatesIndexVm
@{
    ViewData["Title"] = L["tp.title"];

    // PRG toast handoff after create/bulk (emails precedent).
    if (TempData["TpToast"] is string toastKey)
    {
        var ok = TempData["TpToastOk"] as int? ?? 0;
        var skipped = TempData["TpToastSkipped"] as int? ?? 0;
        ViewData["Toast"] = toastKey is "tp.bulkDone" or "tp.bulkPartial"
            ? L.GetString(toastKey, ok, skipped)
            : L[toastKey].Value;
        if (TempData["TpToastError"] is not null)
        {
            ViewData["ToastVariant"] = "error";
        }
    }

    string UpdatedText(DateTimeOffset value) =>
        value.ToLocalTime().ToString(L.GetString("tp.dateFmt"), CultureInfo.CurrentUICulture);

    // Language codes render as autonyms — data, not UI copy (mockup cells).
    string LangText(string lang) => lang == "en" ? "English" : "Türkçe";

    // Canonical querystring builder so header sort / pagination preserve state.
    string BuildUrl(string? sortOver = null, string? dirOver = null, int? pageOver = null)
    {
        var parts = new List<string>();
        void Add(string k, string? v)
        {
            if (!string.IsNullOrEmpty(v))
                parts.Add($"{k}={Uri.EscapeDataString(v)}");
        }
        Add("q", Model.Query);
        Add("sort", sortOver ?? Model.Sort);
        Add("dir", dirOver ?? (Model.Desc ? "desc" : "asc"));
        if (pageOver is { } pg && pg > 1)
            Add("page", pg.ToString());
        return "/admin/templates" + (parts.Count > 0 ? "?" + string.Join("&", parts) : "");
    }
    string SortUrl(string key) => Model.Sort == key
        ? BuildUrl(sortOver: key, dirOver: Model.Desc ? "asc" : "desc")
        : BuildUrl(sortOver: key, dirOver: key is "name" or "updated" ? "desc" : "asc");
    string SortClass(string key) => Model.Sort != key ? "sortable" : Model.Desc ? "sortable sorted-desc" : "sortable sorted-asc";
    var currentUrl = BuildUrl(pageOver: Model.Page);
}

<div class="bo-page-head">
    <div>
        <h1>@L["tp.title"]</h1>
        <p>@L["tp.subtitle"]</p>
    </div>
    <div class="actions">
        <button class="rd-btn-primary" data-dialog-open="dlg-new-set">@L["tp.add"]</button>
    </div>
</div>

<form class="rd-list-toolbar" method="get" action="/admin/templates">
    <input type="hidden" name="sort" value="@Model.Sort">
    <input type="hidden" name="dir" value="@(Model.Desc ? "desc" : "asc")">
    <input type="search" class="rd-control" name="q" value="@Model.Query" placeholder="@L["tp.searchPh"]">
    <span class="spacer"></span>
    @* Mockup's dead bulk buttons act on the checkbox selection (emails precedent). *@
    <button class="rd-btn" type="submit" form="tp-bulk" name="act" value="enable">@SL["common.enable"]</button>
    <button class="rd-btn" type="submit" form="tp-bulk" name="act" value="disable">@SL["common.disable"]</button>
    <button class="rd-btn rd-btn-danger" type="button" data-dialog-open="dlg-bulk-delete">@SL["common.delete"]</button>
</form>

<div class="rd-surface" id="tbl-templates">
    @if (Model.Rows.Count == 0)
    {
        @* Mockup's hidden #empty-templates panel, reachable for real (B1). *@
        <div class="rd-empty">
            <div class="icon">❏</div>
            <h3>@L["tp.emptyTitle"]</h3>
            <p>@L["tp.emptyText"]</p>
            <button class="rd-btn-primary" data-dialog-open="dlg-new-set">@L["tp.add"]</button>
        </div>
    }
    else
    {
    <div style="overflow-x:auto">
        <table class="rd-table">
            <thead>
                <tr>
                    <th class="col-check"><input type="checkbox" data-check-all="#tbl-templates" title="@SL["common.selectAll"]"></th>
                    <th class="@SortClass("name")"><a href="@SortUrl("name")">@L["tp.colName"]</a></th>
                    <th class="@SortClass("status")"><a href="@SortUrl("status")">@SL["common.status"]</a></th>
                    <th>@L["tp.colInUse"]</th>
                    <th class="@SortClass("lang")"><a href="@SortUrl("lang")">@L["tp.colLang"]</a></th>
                    <th class="@SortClass("updated")"><a href="@SortUrl("updated")">@SL["common.updated"]</a></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td class="col-check"><input type="checkbox" name="ids" value="@r.Id" form="tp-bulk"></td>
                        <td><a href="/admin/template-edit?id=@r.Id">@r.Name</a></td>
                        <td>
                            @if (r.IsActive)
                            {
                                <span class="rd-pill rd-pill-teal">@SL["common.active"]</span>
                            }
                            else
                            {
                                <span class="rd-pill rd-pill-closed">@SL["common.disabled"]</span>
                            }
                        </td>
                        @if (r.InUse)
                        {
                            <td>✓</td>
                        }
                        else
                        {
                            <td class="rd-muted">—</td>
                        }
                        <td>@LangText(r.Language)</td>
                        <td>@UpdatedText(r.Updated)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="rd-pagination">
        <span>@SL["common.showing"]</span><span>@Model.From–@Model.To / @Model.Total</span>
        <div class="pages">
            @for (var p = 1; p <= Model.PageCount; p++)
            {
                if (p == Model.Page)
                {
                    <span class="current">@p</span>
                }
                else
                {
                    <a href="@BuildUrl(pageOver: p)">@p</a>
                }
            }
        </div>
    </div>
    }
</div>

@* Selection carrier for the toolbar bulk actions (emails precedent). *@
<form id="tp-bulk" method="post" asp-area="Admin" asp-controller="Templates" asp-action="Bulk" hidden>
    <input type="hidden" name="returnUrl" value="@currentUrl">
</form>

@* Yeni set dialogu (B2): the submit is a REAL create — no data-dialog-close on it,
   the PRG redirect is what closes the dialog (the S0-audited defect fixed). *@
<dialog class="rd-dialog" id="dlg-new-set">
    <form method="post" asp-area="Admin" asp-controller="Templates" asp-action="Create">
        <div class="rd-dialog-head">
            <span>@L["tp.dlgTitle"]</span>
            <button type="button" class="close" data-dialog-close aria-label="@SL["common.close"]">✕</button>
        </div>
        <div class="rd-dialog-body">
            <div class="rd-field">
                <label class="rd-label" for="tp-name">@L["tp.dlgName"]</label>
                <input id="tp-name" name="name" class="rd-control" type="text" placeholder="Kurumsal (TR)" required>
                <p class="rd-help">@L["tp.dlgNameHelp"]</p>
            </div>
            <div class="rd-field">
                <label class="rd-label" for="tp-clone">@L["tp.dlgClone"]</label>
                <select id="tp-clone" name="cloneId" class="rd-control">
                    <option value="" selected>@L["tp.dlgStock"]</option>
                    @foreach (var s in Model.CloneOptions)
                    {
                        <option value="@s.Id">@s.Label</option>
                    }
                </select>
                <p class="rd-help">@L["tp.dlgCloneHelp"]</p>
            </div>
            <div class="rd-field mb-0">
                <label class="rd-label" for="tp-lang">@L["tp.dlgLang"]</label>
                <select id="tp-lang" name="lang" class="rd-control">
                    <option value="tr" selected>Türkçe</option>
                    <option value="en">English</option>
                </select>
                <p class="rd-help">@L["tp.dlgLangHelp"]</p>
            </div>
        </div>
        <div class="rd-dialog-foot">
            <button type="button" class="rd-btn" data-dialog-close>@SL["common.cancel"]</button>
            <button class="rd-btn-primary">@L["tp.create"]</button>
        </div>
    </form>
</dialog>

@* Bulk delete confirm dialog: invented UI (B2, emails precedent). Sets referenced by
   the email settings default or a department template-set pointer are skipped. *@
<dialog class="rd-dialog" id="dlg-bulk-delete">
    <div class="rd-dialog-head">
        <span>@SL["common.delete"]</span>
        <button class="close" data-dialog-close>✕</button>
    </div>
    <div class="rd-dialog-body">
        <p>@L["tp.deleteConfirm"]</p>
    </div>
    <div class="rd-dialog-foot">
        <button type="button" class="rd-btn" data-dialog-close>@SL["common.cancel"]</button>
        <button type="submit" class="rd-btn rd-btn-danger" form="tp-bulk" name="act" value="delete">@SL["common.delete"]</button>
    </div>
</dialog>
