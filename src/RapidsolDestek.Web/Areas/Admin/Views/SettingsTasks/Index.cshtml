@using RapidsolDestek.Web.Areas.Admin.Controllers
@model SettingsTasksVm
@{
    ViewData["Title"] = L["tg.title"];

    // Toast handoff (settings-tickets precedent): PRG keys via TempData.
    if (TempData["TgToast"] is string toastKey)
    {
        ViewData["Toast"] = L[toastKey].Value;
        if (TempData["TgToastError"] is not null)
        {
            ViewData["ToastVariant"] = "error";
        }
    }
}

<div class="bo-page-head">
    <div>
        <h1>@L["tg.title"]</h1>
        <p>@L["tg.subtitle"]</p>
    </div>
</div>

<div class="bo-settings">
    <nav class="bo-section-index" aria-label="Sections">
        <a href="#sec-numbering" class="active">@L["tg.secNumbering"]</a>
        <a href="#sec-defaults">@L["tg.secDefaults"]</a>
        <a href="#sec-alerts">@L["tg.secAlerts"]</a>
    </nav>

    <form class="bo-settings-sections" method="post" asp-area="Admin" asp-controller="SettingsTasks" asp-action="Save">

        <section class="rd-surface bo-section" id="sec-numbering">
            <div class="rd-surface-head"><span>@L["tg.secNumbering"]</span></div>
            <div class="rd-surface-body">
                <div class="rd-field">
                    <label class="rd-label" for="ta-format">@L["tg.numberFormat"]</label>
                    <input id="ta-format" class="rd-control" name="number_format" value="@Model.NumberFormat" required style="max-width:220px">
                    <div class="rd-help">@L["tg.numberFormatHelp"]</div>
                </div>
                <div class="rd-field mb-0">
                    <label class="rd-label" for="ta-seq">@L["tg.sequence"]</label>
                    <div class="bo-rule-row" style="margin-bottom:0">
                        <select id="ta-seq" class="rd-control" name="number_mode" style="max-width:220px">
                            <option value="random" selected="@(Model.NumberMode == "random")">@L["tg.seqRandom"]</option>
                            <option value="sequential" selected="@(Model.NumberMode == "sequential")">@L["tg.seqSequential"]</option>
                        </select>
                        <button type="button" class="rd-btn" data-dialog-open="dlg-seq">@L["tg.manage"]</button>
                    </div>
                    <div class="rd-help">@L["tg.sequenceHelp"]</div>
                </div>
            </div>
        </section>

        <section class="rd-surface bo-section" id="sec-defaults">
            <div class="rd-surface-head"><span>@L["tg.secDefaults"]</span></div>
            <div class="rd-surface-body">
                <div class="rd-field">
                    <label class="rd-label" for="ta-priority">@L["tg.defPriority"]</label>
                    <select id="ta-priority" class="rd-control" name="default_priority" style="max-width:340px">
                        @foreach (var key in Model.PriorityKeys)
                        {
                            <option value="@key" selected="@(Model.DefaultPriority == key)">@SL[$"priority.{key}"]</option>
                        }
                    </select>
                    <div class="rd-help">@L["tg.defPriorityHelp"]</div>
                </div>
                <div class="rd-banner rd-banner-info" style="margin-bottom:0">
                    <span aria-hidden="true">📎</span>
                    <span>
                        <span>@L["tg.attachNote"]</span>
                        <a href="/admin/forms">@L["tg.attachNoteLink"]</a>
                    </span>
                </div>
            </div>
        </section>

        <section class="rd-surface bo-section" id="sec-alerts">
            <div class="rd-surface-head"><span>@L["tg.secAlerts"]</span></div>
            <div class="rd-surface-body">

                <div class="bo-toggle-card">
                    <div class="head">
                        <div>
                            <b>@L["tg.alNewTask"]</b>
                            <small>@L["tg.alNewTaskHelp"]</small>
                        </div>
                        <label class="rd-switch"><input type="checkbox" name="tal_new" value="true" checked="@Model.Alerts["task_new"]" data-gates="#rcp-tasknew"><span class="track"></span></label>
                    </div>
                    <div class="recipients" id="rcp-tasknew">
                        <label class="rd-check"><input type="checkbox" name="tal_new_admin" value="true" checked="@Model.Alerts["task_new_admin"]"><span>@L["tg.rcpAdmin"]</span></label>
                        <label class="rd-check"><input type="checkbox" name="tal_new_dept_manager" value="true" checked="@Model.Alerts["task_new_dept_manager"]"><span>@L["tg.rcpDeptManager"]</span></label>
                        <label class="rd-check"><input type="checkbox" name="tal_new_dept_members" value="true" checked="@Model.Alerts["task_new_dept_members"]"><span>@L["tg.rcpDeptMembers"]</span></label>
                    </div>
                </div>

                <div class="bo-toggle-card">
                    <div class="head">
                        <div>
                            <b>@L["tg.alNewActivity"]</b>
                            <small>@L["tg.alNewActivityHelp"]</small>
                        </div>
                        <label class="rd-switch"><input type="checkbox" name="tal_activity" value="true" checked="@Model.Alerts["task_activity"]" data-gates="#rcp-taskactivity"><span class="track"></span></label>
                    </div>
                    <div class="recipients" id="rcp-taskactivity">
                        <label class="rd-check"><input type="checkbox" name="tal_activity_last_respondent" value="true" checked="@Model.Alerts["task_activity_last_respondent"]"><span>@L["tg.rcpLastRespondent"]</span></label>
                        <label class="rd-check"><input type="checkbox" name="tal_activity_assigned" value="true" checked="@Model.Alerts["task_activity_assigned"]"><span>@L["tg.rcpAssigned"]</span></label>
                        <label class="rd-check"><input type="checkbox" name="tal_activity_dept_manager" value="true" checked="@Model.Alerts["task_activity_dept_manager"]"><span>@L["tg.rcpDeptManager"]</span></label>
                    </div>
                </div>

                <div class="bo-toggle-card">
                    <div class="head">
                        <div>
                            <b>@L["tg.alAssignment"]</b>
                            <small>@L["tg.alAssignmentHelp"]</small>
                        </div>
                        <label class="rd-switch"><input type="checkbox" name="tal_assignment" value="true" checked="@Model.Alerts["task_assignment"]" data-gates="#rcp-taskassignment"><span class="track"></span></label>
                    </div>
                    <div class="recipients" id="rcp-taskassignment">
                        <label class="rd-check"><input type="checkbox" name="tal_assignment_assigned" value="true" checked="@Model.Alerts["task_assignment_assigned"]"><span>@L["tg.rcpAssigned"]</span></label>
                        <label class="rd-check"><input type="checkbox" name="tal_assignment_team_lead" value="true" checked="@Model.Alerts["task_assignment_team_lead"]"><span>@L["tg.rcpTeamLead"]</span></label>
                        <label class="rd-check"><input type="checkbox" name="tal_assignment_team_members" value="true" checked="@Model.Alerts["task_assignment_team_members"]"><span>@L["tg.rcpTeamMembers"]</span></label>
                    </div>
                </div>

                <div class="bo-toggle-card">
                    <div class="head">
                        <div>
                            <b>@L["tg.alTransfer"]</b>
                            <small>@L["tg.alTransferHelp"]</small>
                        </div>
                        <label class="rd-switch"><input type="checkbox" name="tal_transfer" value="true" checked="@Model.Alerts["task_transfer"]" data-gates="#rcp-tasktransfer"><span class="track"></span></label>
                    </div>
                    <div class="recipients" id="rcp-tasktransfer">
                        <label class="rd-check"><input type="checkbox" name="tal_transfer_assigned" value="true" checked="@Model.Alerts["task_transfer_assigned"]"><span>@L["tg.rcpAssigned"]</span></label>
                        <label class="rd-check"><input type="checkbox" name="tal_transfer_dept_manager" value="true" checked="@Model.Alerts["task_transfer_dept_manager"]"><span>@L["tg.rcpDeptManager"]</span></label>
                    </div>
                </div>

                <div class="bo-toggle-card" style="margin-bottom:0">
                    <div class="head">
                        <div>
                            <b>@L["tg.alOverdue"]</b>
                            <small>@L["tg.alOverdueHelp"]</small>
                        </div>
                        <label class="rd-switch"><input type="checkbox" name="tal_overdue" value="true" checked="@Model.Alerts["task_overdue"]" data-gates="#rcp-taskoverdue"><span class="track"></span></label>
                    </div>
                    <div class="recipients" id="rcp-taskoverdue">
                        <label class="rd-check"><input type="checkbox" name="tal_overdue_assigned" value="true" checked="@Model.Alerts["task_overdue_assigned"]"><span>@L["tg.rcpAssigned"]</span></label>
                        <label class="rd-check"><input type="checkbox" name="tal_overdue_dept_manager" value="true" checked="@Model.Alerts["task_overdue_dept_manager"]"><span>@L["tg.rcpDeptManager"]</span></label>
                        <label class="rd-check"><input type="checkbox" name="tal_overdue_dept_members" value="true" checked="@Model.Alerts["task_overdue_dept_members"]"><span>@L["tg.rcpDeptMembers"]</span></label>
                    </div>
                </div>

            </div>
        </section>

        <div style="display:flex;gap:10px;justify-content:flex-end">
            <button type="reset" class="rd-btn">@SL["common.reset"]</button>
            <button type="submit" class="rd-btn rd-btn-primary">@SL["common.save"]</button>
        </div>
    </form>
</div>

<dialog class="rd-dialog" id="dlg-seq">
    <div class="rd-dialog-head">
        <span>@L["tg.dlgSeqTitle"]</span>
        <button class="close" data-dialog-close aria-label="@SL["common.close"]">✕</button>
    </div>
    @* B4 CRUD over the mockup's static rows (settings-tickets dlg-seq twin — same
       SequenceNumberService guards, this page's own POST so the redirect returns
       here). Submit carries no data-dialog-close (the audited B2 bug). *@
    <form method="post" asp-area="Admin" asp-controller="SettingsTasks" asp-action="Sequences">
        <div class="rd-dialog-body">
            <p class="rd-help" style="margin:0 0 12px">@L["tg.dlgSeqHelp"]</p>
            <table class="rd-table">
                <thead>
                    <tr>
                        <th>@L["tg.seqName"]</th>
                        <th class="num">@L["tg.seqNext"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="seq-rows">
                    @foreach (var seq in Model.Sequences)
                    {
                        <tr class="bo-rule-row">
                            <td>
                                <input type="hidden" name="seqId" value="@seq.Id">
                                <input class="rd-control" name="seqName" value="@seq.Name" required>
                            </td>
                            <td class="num">
                                <input class="rd-control" type="number" name="seqNext" value="@seq.Next" min="@seq.Next" required style="max-width:140px;text-align:right">
                            </td>
                            <td><button type="button" class="rd-btn rd-btn-ghost rd-btn-sm remove" style="color:var(--rd-red)">✕</button></td>
                        </tr>
                    }
                </tbody>
            </table>
            <button type="button" class="rd-btn rd-btn-sm" style="margin-top:12px" data-rule-add="tpl-seq-row" data-rule-into="#seq-rows">@L["tg.addSequence"]</button>
        </div>
        <div class="rd-dialog-foot">
            <button type="button" class="rd-btn" data-dialog-close>@SL["common.cancel"]</button>
            <button type="submit" class="rd-btn rd-btn-primary">@SL["common.save"]</button>
        </div>
    </form>
</dialog>

<template id="tpl-seq-row">
    <tr class="bo-rule-row">
        <td>
            <input type="hidden" name="seqId" value="0">
            <input class="rd-control" name="seqName" required>
        </td>
        <td class="num">
            <input class="rd-control" type="number" name="seqNext" value="1" min="1" required style="max-width:140px;text-align:right">
        </td>
        <td><button type="button" class="rd-btn rd-btn-ghost rd-btn-sm remove" style="color:var(--rd-red)">✕</button></td>
    </tr>
</template>
