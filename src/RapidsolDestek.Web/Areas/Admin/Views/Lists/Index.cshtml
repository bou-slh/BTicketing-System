@using System.Globalization
@using RapidsolDestek.Web.Areas.Admin.Controllers
@model ListsIndexVm
@{
    ViewData["Title"] = L["ls.title"];

    // PRG toast handoff after bulk/delete (slas/schedules precedent).
    if (TempData["ListsToast"] is string toastKey)
    {
        var ok = TempData["ListsToastOk"] as int? ?? 0;
        var skipped = TempData["ListsToastSkipped"] as int? ?? 0;
        @* GetString: LocalizedHtmlString.Value would return the UNFORMATTED resource. *@
        ViewData["Toast"] = toastKey is "ls.bulkDone" or "ls.bulkPartial"
            ? L.GetString(toastKey, ok, skipped).Value
            : L[toastKey].Value;
        if (TempData["ListsToastError"] is not null)
        {
            ViewData["ToastVariant"] = "error";
        }
    }

    // Date cells: the mockup's "3 Oca 2026" format (ls.dateFmt).
    string DateText(DateTimeOffset value) =>
        value.ToLocalTime().ToString(L.GetString("ls.dateFmt"), CultureInfo.CurrentUICulture);

    string BuildUrl(string? sortOver = null, string? dirOver = null, int? pageOver = null)
    {
        var parts = new List<string>();
        void Add(string k, string? v)
        {
            if (!string.IsNullOrEmpty(v))
                parts.Add($"{k}={Uri.EscapeDataString(v)}");
        }
        Add("q", Model.Query);
        Add("sort", sortOver ?? Model.Sort);
        Add("dir", dirOver ?? (Model.Desc ? "desc" : "asc"));
        if (pageOver is { } pg && pg > 1)
            Add("page", pg.ToString());
        return "/admin/lists" + (parts.Count > 0 ? "?" + string.Join("&", parts) : "");
    }
    string SortUrl(string key) => Model.Sort == key
        ? BuildUrl(sortOver: key, dirOver: Model.Desc ? "asc" : "desc")
        : BuildUrl(sortOver: key, dirOver: key == "updated" ? "desc" : "asc");
    string SortClass(string key) => Model.Sort != key ? "sortable" : Model.Desc ? "sortable sorted-desc" : "sortable sorted-asc";
    var currentUrl = BuildUrl(pageOver: Model.Page);
}

<div class="bo-page-head">
    <div>
        <h1>@L["ls.title"]</h1>
        <p>@L["ls.sub"]</p>
    </div>
</div>

<form class="rd-list-toolbar" method="get" action="/admin/lists">
    <input type="hidden" name="sort" value="@Model.Sort">
    <input type="hidden" name="dir" value="@(Model.Desc ? "desc" : "asc")">
    <input type="search" class="rd-control" name="q" value="@Model.Query" placeholder="@L["ls.searchPh"]">
    <span class="spacer"></span>
    <button class="rd-btn" type="button" data-dialog-open="dlg-more"><span>@SL["common.more"]</span> ▾</button>
    <a class="rd-btn rd-btn-primary" href="/admin/list-edit">@L["ls.new"]</a>
</form>

<div class="rd-surface" id="tbl-lists-wrap">
    @if (Model.Rows.Count == 0)
    {
        @* Mockup's hidden #ls-empty panel, reachable for real (B1). *@
        <div class="rd-empty">
            <div class="icon">≔</div>
            <h3>@L["ls.emptyTitle"]</h3>
            <p>@L["ls.emptyText"]</p>
            <a class="rd-btn rd-btn-primary" href="/admin/list-edit">@L["ls.new"]</a>
        </div>
    }
    else
    {
    <table class="rd-table" id="tbl-lists">
        <thead>
            <tr>
                <th class="col-check"><input type="checkbox" data-check-all="#tbl-lists" title="@SL["common.selectAll"]"></th>
                <th class="@SortClass("name")"><a href="@SortUrl("name")">@L["ls.colName"]</a></th>
                <th class="num">@L["ls.colItems"]</th>
                <th class="@SortClass("created")"><a href="@SortUrl("created")">@SL["common.created"]</a></th>
                <th class="@SortClass("updated")"><a href="@SortUrl("updated")">@SL["common.updated"]</a></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    @* System rows: disabled checkbox per the mockup — the server
                       guard skips them from bulk actions regardless. *@
                    <td class="col-check"><input type="checkbox" name="ids" value="@r.Id" form="ls-bulk" disabled="@r.IsSystem"></td>
                    <td>
                        <a href="/admin/list-edit?id=@r.Id">@r.Name</a>
                        @if (r.IsSystem)
                        {
                            <span class="rd-pill rd-pill-teal">@L["ls.builtin"]</span>
                        }
                    </td>
                    <td class="num">@r.ItemCount</td>
                    <td>@DateText(r.Created)</td>
                    <td>@DateText(r.Updated)</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="rd-pagination">
        <span>@L["ls.showing", Model.From, Model.To, Model.Total]</span>
        <div class="pages">
            @for (var p = 1; p <= Model.PageCount; p++)
            {
                if (p == Model.Page)
                {
                    <span class="current">@p</span>
                }
                else
                {
                    <a href="@BuildUrl(pageOver: p)">@p</a>
                }
            }
        </div>
    </div>
    }
</div>

@* Selection carrier for the dlg-more bulk actions (slas precedent). *@
<form id="ls-bulk" method="post" asp-area="Admin" asp-controller="Lists" asp-action="Bulk" hidden>
    <input type="hidden" name="returnUrl" value="@currentUrl">
</form>

<dialog class="rd-dialog" id="dlg-more">
    <div class="rd-dialog-head"><span>@L["ls.bulkTitle"]</span><button class="close" data-dialog-close>✕</button></div>
    <div class="rd-dialog-body">
        <p class="rd-help" style="margin-top:0">@L["ls.bulkHelp"]</p>
        <div style="display:flex;flex-direction:column;gap:9px;margin-top:12px">
            @* No data-dialog-close on the submits — the audited B2 close-swallows-save bug. *@
            <button class="rd-btn" type="submit" form="ls-bulk" name="act" value="enable">@SL["common.enable"]</button>
            <button class="rd-btn" type="submit" form="ls-bulk" name="act" value="disable">@SL["common.disable"]</button>
            <button class="rd-btn rd-btn-danger" type="button" data-dialog-open="dlg-delete" data-dialog-close>@SL["common.delete"]</button>
        </div>
    </div>
</dialog>

<dialog class="rd-dialog" id="dlg-delete">
    <div class="rd-dialog-head"><span>@SL["common.delete"]</span><button class="close" data-dialog-close>✕</button></div>
    <div class="rd-dialog-body"><p>@SL["common.confirmDelete"]</p></div>
    <div class="rd-dialog-foot">
        <button class="rd-btn" type="button" data-dialog-close>@SL["common.cancel"]</button>
        <button class="rd-btn rd-btn-danger" type="submit" form="ls-bulk" name="act" value="delete">@SL["common.delete"]</button>
    </div>
</dialog>
