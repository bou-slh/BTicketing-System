@using System.Globalization
@using RapidsolDestek.Web.Areas.Agent.Controllers
@model OrgsIndexVm
@{
    ViewData["Title"] = L["og.title"];

    // PRG toast handoff after a refused create (users-page precedent).
    if (TempData["OrgsToast"] is string toastKey)
    {
        ViewData["Toast"] = L[toastKey].Value;
        if (TempData["OrgsToastError"] is not null)
        {
            ViewData["ToastVariant"] = "error";
        }
    }

    // Avatar cell: first letter of the company name (mockup "U"/"T"/"K"/"R").
    static string Initial(string name) =>
        name.Length == 0 ? "" : char.ToUpperInvariant(name[0]).ToString();

    // Updated cell: "Bugün 09:12" / "Dün 17:05" / "8 Ağu 2026" (users-page derivation).
    string UpdatedText(DateTimeOffset value)
    {
        var local = value.ToLocalTime();
        var today = DateTime.Now.Date;
        if (local.Date == today)
            return L.GetString("og.updToday", local.ToString("HH:mm"));
        if (local.Date == today.AddDays(-1))
            return L.GetString("og.updYesterday", local.ToString("HH:mm"));
        return local.ToString(L.GetString("og.dateFmt"), CultureInfo.CurrentUICulture);
    }

    // Canonical querystring builder so header sort / pagination / export preserve state.
    string BuildUrl(string? sortOver = null, string? dirOver = null, int? pageOver = null, string path = "/agent/orgs")
    {
        var parts = new List<string>();
        void Add(string k, string? v)
        {
            if (!string.IsNullOrEmpty(v))
                parts.Add($"{k}={Uri.EscapeDataString(v)}");
        }
        Add("q", Model.Query);
        Add("sort", sortOver ?? Model.Sort);
        Add("dir", dirOver ?? (Model.Desc ? "desc" : "asc"));
        if (pageOver is { } pg && pg > 1)
            Add("page", pg.ToString());
        return path + (parts.Count > 0 ? "?" + string.Join("&", parts) : "");
    }
    string SortUrl(string key) => Model.Sort == key
        ? BuildUrl(sortOver: key, dirOver: Model.Desc ? "asc" : "desc")
        : BuildUrl(sortOver: key, dirOver: key is "users" or "open" or "updated" ? "desc" : "asc");
    string SortClass(string key) => Model.Sort != key ? "sortable" : Model.Desc ? "sortable sorted-desc" : "sortable sorted-asc";
}

<div class="bo-page-head rc-hero">
    <div>
        <h1>@L["og.title"]</h1>
        <p>@L["og.subtitle"]</p>
    </div>
    <div class="actions">
        <button class="rd-btn-primary" data-dialog-open="dlg-addorg">@L["og.add"]</button>
    </div>
</div>

<form class="rd-list-toolbar" method="get" action="/agent/orgs">
    <input type="hidden" name="sort" value="@Model.Sort">
    <input type="hidden" name="dir" value="@(Model.Desc ? "desc" : "asc")">
    <input type="search" class="rd-control" name="q" value="@Model.Query" placeholder="@L["og.searchPh"]">
    <span class="spacer"></span>
    @* Mockup's dead Dışa Aktar button → CSV of the current list (tickets export precedent). *@
    <a class="rd-btn rd-btn-ghost" href="@BuildUrl(path: "/agent/orgs/export")">@SL["common.export"]</a>
</form>

<div class="rd-surface">
    @if (Model.Rows.Count == 0)
    {
        @* Invented per B1 (reachable empty state on search miss) — the mockup defines none. *@
        <div class="rd-empty">
            <div class="icon">▣</div>
            <h3>@L["og.emptyTitle"]</h3>
            <p>@L["og.emptyText"]</p>
            <button class="rd-btn-primary" data-dialog-open="dlg-addorg">@L["og.add"]</button>
        </div>
    }
    else
    {
    <div style="overflow-x:auto">
        <table class="rd-table" id="tbl-orgs">
            <thead>
                <tr>
                    <th class="col-check"><input type="checkbox" data-check-all="#tbl-orgs" aria-label="@SL["common.selectAll"]"></th>
                    <th class="@SortClass("name")"><a href="@SortUrl("name")">@L["og.colName"]</a></th>
                    <th class="@SortClass("sector")"><a href="@SortUrl("sector")">@L["og.colSector"]</a></th>
                    <th class="num @SortClass("users")"><a href="@SortUrl("users")">@L["og.colUsers"]</a></th>
                    <th class="num @SortClass("open")"><a href="@SortUrl("open")">@L["og.colOpen"]</a></th>
                    <th class="@SortClass("manager")"><a href="@SortUrl("manager")">@L["og.colManager"]</a></th>
                    <th class="@SortClass("updated")"><a href="@SortUrl("updated")">@SL["common.updated"]</a></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td><input type="checkbox" value="@r.Id"></td>
                        <td>
                            <a href="/agent/org-view?id=@r.Id" style="display:inline-flex;align-items:center;gap:10px">
                                <span class="rd-avatar">@Initial(r.Name)</span> @r.Name
                            </a>
                        </td>
                        <td>@(r.Sector ?? "—")</td>
                        <td class="num">@r.UserCount</td>
                        <td class="num">@r.OpenCount</td>
                        <td>@(r.ManagerName is null ? "—" : ShortName(r.ManagerName))</td>
                        <td>@UpdatedText(r.Updated)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="rd-pagination">
        <span><span>@SL["common.showing"]</span> @Model.From–@Model.To / @Model.Total</span>
        <div class="pages">
            @for (var p = 1; p <= Model.PageCount; p++)
            {
                if (p == Model.Page)
                {
                    <span class="current">@p</span>
                }
                else
                {
                    <a href="@BuildUrl(pageOver: p)">@p</a>
                }
            }
        </div>
    </div>
    }
</div>

<dialog class="rd-dialog" id="dlg-addorg">
    <div class="rd-dialog-head">
        <span>@L["og.dlgTitle"]</span>
        <button class="close" data-dialog-close aria-label="@SL["common.close"]">✕</button>
    </div>
    <form method="post" asp-area="Agent" asp-controller="Orgs" asp-action="Create">
        <div class="rd-dialog-body">
            <div class="rd-field">
                <label class="rd-label" for="ao-name">@L["og.fName"]</label>
                <input id="ao-name" name="name" class="rd-control" required>
            </div>
            <div class="rd-field">
                <label class="rd-label" for="ao-domain">@L["og.fDomain"]</label>
                <input id="ao-domain" name="domain" class="rd-control" placeholder="@@sirket.com.tr">
                <div class="rd-help">@L["og.fDomainHelp"]</div>
            </div>
            <div class="rd-grid-2">
                <div class="rd-field">
                    <label class="rd-label" for="ao-sector">@L["og.fSector"]</label>
                    <input id="ao-sector" name="sector" class="rd-control">
                </div>
                <div class="rd-field">
                    <label class="rd-label" for="ao-manager">@L["og.fManager"]</label>
                    <select id="ao-manager" name="managerId" class="rd-control">
                        @* Invented "—" option (users us.fOrgNone precedent): the column is nullable. *@
                        <option value="">@L["og.fManagerNone"]</option>
                        @foreach (var s in Model.StaffOptions)
                        {
                            <option value="@s.Id">@ShortName(s.Name)</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <div class="rd-dialog-foot">
            <button type="button" class="rd-btn" data-dialog-close>@SL["common.cancel"]</button>
            <button type="submit" class="rd-btn-primary">@SL["common.add"]</button>
        </div>
    </form>
</dialog>

@functions {
    // Table-cell agent name convention (§2 canon): "Ümit Yaşar Akın" → "Ümit Y. Akın".
    static string ShortName(string full)
    {
        var parts = full.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length < 3)
            return full;
        var middles = string.Join(" ", parts[1..^1].Select(p => $"{char.ToUpperInvariant(p[0])}."));
        return $"{parts[0]} {middles} {parts[^1]}";
    }
}
