@using System.Globalization
@using RapidsolDestek.Web.Areas.Agent.Controllers
@model TasksIndexVm
@{
    ViewData["Title"] = L["ta.title"];

    // PRG toast handoff after bulk actions / failed create (tickets-page precedent).
    if (TempData["TasksBulkNone"] is not null)
    {
        ViewData["Toast"] = L["ta.bulkNone"].Value;
        ViewData["ToastVariant"] = "error";
    }
    else if (TempData["TasksBulkOk"] is int bulkOk)
    {
        var bulkSkipped = TempData["TasksBulkSkipped"] as int? ?? 0;
        ViewData["Toast"] = bulkSkipped > 0
            ? L["ta.bulkPartial", bulkOk, bulkSkipped].Value
            : L["ta.bulkDone", bulkOk].Value;
    }

    // Table-cell agent name convention (§2 canon): "Ümit Yaşar Akın" → "Ümit Y. Akın".
    static string ShortName(string? full)
    {
        if (string.IsNullOrWhiteSpace(full))
            return "—";
        var parts = full.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length < 3)
            return full;
        var middles = string.Join(" ", parts[1..^1].Select(p => $"{char.ToUpperInvariant(p[0])}."));
        return $"{parts[0]} {middles} {parts[^1]}";
    }

    // Date cell, mockup format: "11 Ağu 2026".
    string DateText(DateTimeOffset value) =>
        value.ToLocalTime().ToString(L.GetString("ta.dateFmt"), CultureInfo.CurrentUICulture);

    // Canonical querystring builder so tabs / header sort / pagination preserve the list state.
    string BuildUrl(string? tabOver = null, string? sortOver = null, string? dirOver = null, int? pageOver = null)
    {
        var parts = new List<string>();
        void Add(string k, string? v)
        {
            if (!string.IsNullOrEmpty(v))
                parts.Add($"{k}={Uri.EscapeDataString(v)}");
        }
        Add("tab", tabOver ?? Model.Tab);
        Add("q", Model.Query);
        if (tabOver is null)
        {
            Add("sort", sortOver ?? Model.Sort);
            Add("dir", dirOver ?? (Model.Desc ? "desc" : "asc"));
        }
        if (pageOver is { } pg && pg > 1)
            Add("page", pg.ToString());
        return "/agent/tasks" + (parts.Count > 0 ? "?" + string.Join("&", parts) : "");
    }
    string SortUrl(string key) => Model.Sort == key
        ? BuildUrl(sortOver: key, dirOver: Model.Desc ? "asc" : "desc")
        : BuildUrl(sortOver: key, dirOver: key is "date" or "no" ? "desc" : "asc");
    string SortClass(string key) => Model.Sort != key ? "sortable" : Model.Desc ? "sortable sorted-desc" : "sortable sorted-asc";
    var currentUrl = BuildUrl(pageOver: Model.Page);

    string TabLabel(string tab) => tab switch
    {
        "open" => L["ta.qOpen"].Value,
        "mine" => L["ta.qMine"].Value,
        "overdue" => L["ta.qOverdue"].Value,
        "done" => L["ta.qDone"].Value,
        _ => tab,
    };

    // Mockup panel/table ids per tab (the "mine" panel carries the plain ids).
    var panelId = Model.Tab == "mine" ? "ta-panel-mine" : $"ta-panel-{Model.Tab}";
    var tableId = Model.Tab == "mine" ? "tbl-tasks" : $"tbl-tasks-{Model.Tab}";
}

<div class="bo-page-head rc-hero">
    <div>
        <h1>@L["ta.title"]</h1>
        <p>@L["ta.subtitle"]</p>
    </div>
    <div class="actions">
        <button class="rd-btn-primary" data-dialog-open="dlg-newtask">@L["ta.new"]</button>
    </div>
</div>

@* Mockup tab bar (fixed in S0): server round-trip links instead of client data-tabs —
   only the active tab's panel is rendered from data (agent-login <a>→<button> precedent). *@
<div class="rd-tabs">
    @foreach (var tab in TasksController.Tabs)
    {
        <a class="@(tab == Model.Tab ? "active" : null)" href="@BuildUrl(tabOver: tab)"><span>@TabLabel(tab)</span> · @Model.Counts[tab]</a>
    }
</div>

<form class="rd-list-toolbar" method="get" action="/agent/tasks">
    <input type="hidden" name="tab" value="@Model.Tab">
    <input type="hidden" name="sort" value="@Model.Sort">
    <input type="hidden" name="dir" value="@(Model.Desc ? "desc" : "asc")">
    <input type="search" class="rd-control" name="q" value="@Model.Query" placeholder="@L["ta.searchPh"]">
    <span class="spacer"></span>
    <button class="rd-btn" type="submit" form="ta-bulk" name="act" value="assign">@L["ta.assign"]</button>
    <button class="rd-btn" type="button" data-dialog-open="dlg-bulk-transfer">@L["ta.transfer"]</button>
    <button class="rd-btn rd-btn-danger" type="button" data-dialog-open="dlg-bulk-delete">@SL["common.delete"]</button>
</form>

<div class="rd-tab-panel active" id="@panelId">
<div class="rd-surface">
    @if (Model.Rows.Count == 0)
    {
        @* Invented per B1 (reachable empty state) — the mockup defines none for this list. *@
        <div class="rd-empty">
            <div class="icon">☑</div>
            <h3>@L["ta.emptyTitle"]</h3>
            <p>@L["ta.emptyText"]</p>
            <button class="rd-btn-primary" data-dialog-open="dlg-newtask">@L["ta.new"]</button>
        </div>
    }
    else
    {
    <div style="overflow-x:auto">
        <table class="rd-table" id="@tableId">
            <thead>
                <tr>
                    <th class="col-check"><input type="checkbox" data-check-all="#@tableId" aria-label="@SL["common.selectAll"]"></th>
                    <th class="@SortClass("no")"><a href="@SortUrl("no")">@L["ta.colNo"]</a></th>
                    <th class="@SortClass("date")"><a href="@SortUrl("date")">@L["ta.colDate"]</a></th>
                    <th class="@SortClass("title")"><a href="@SortUrl("title")">@L["ta.colTitle"]</a></th>
                    <th>@L["ta.colTicket"]</th>
                    <th class="@SortClass("dept")"><a href="@SortUrl("dept")">@L["ta.colDept"]</a></th>
                    <th class="@SortClass("assignee")"><a href="@SortUrl("assignee")">@L["ta.colAssignee"]</a></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td><input type="checkbox" name="ids" value="@r.Id" form="ta-bulk"></td>
                        <td><a href="/agent/task-view?id=@r.Id">@r.Number</a></td>
                        <td>@DateText(r.Created)</td>
                        <td><a href="/agent/task-view?id=@r.Id">@r.Title</a></td>
                        @if (r.TicketId is { } ticketId)
                        {
                            <td><a href="/agent/ticket-view?id=@ticketId">@r.TicketNumber</a></td>
                        }
                        else
                        {
                            <td class="rd-muted">—</td>
                        }
                        <td>@r.DeptName</td>
                        <td>@ShortName(r.AssigneeName)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="rd-pagination">
        <span><span>@SL["common.showing"]</span> @Model.From–@Model.To / @Model.Total</span>
        <div class="pages">
            @for (var p = 1; p <= Model.PageCount; p++)
            {
                if (p == Model.Page)
                {
                    <span class="current">@p</span>
                }
                else
                {
                    <a href="@BuildUrl(pageOver: p)">@p</a>
                }
            }
        </div>
    </div>
    }
</div>
</div>

@* Selection carrier for the toolbar bulk actions (tickets tq-bulk precedent). *@
<form id="ta-bulk" method="post" asp-area="Agent" asp-controller="Tasks" asp-action="Bulk" hidden>
    <input type="hidden" name="returnUrl" value="@currentUrl">
</form>

<dialog class="rd-dialog" id="dlg-newtask">
    <div class="rd-dialog-head">
        <span>@L["ta.dlgTitle"]</span>
        <button class="close" data-dialog-close aria-label="@SL["common.close"]">✕</button>
    </div>
    <form method="post" asp-area="Agent" asp-controller="Tasks" asp-action="Create">
        <div class="rd-dialog-body">
            <div class="rd-field">
                <label class="rd-label" for="nt-title">@L["ta.fTitle"]</label>
                <input id="nt-title" name="title" class="rd-control" placeholder="@L["ta.fTitlePh"]" required>
            </div>
            <div class="rd-grid-2">
                <div class="rd-field">
                    <label class="rd-label" for="nt-dept">@L["ta.fDept"]</label>
                    <select id="nt-dept" name="departmentId" class="rd-control">
                        @foreach (var dept in Model.Departments)
                        {
                            <option value="@dept.Id">@dept.Name</option>
                        }
                    </select>
                </div>
                <div class="rd-field">
                    <label class="rd-label" for="nt-assignee">@L["ta.fAssignee"]</label>
                    <select id="nt-assignee" name="staffId" class="rd-control">
                        @foreach (var a in Model.Assignees)
                        {
                            <option value="@a.Id">@a.FullName</option>
                        }
                    </select>
                </div>
            </div>
            <div class="rd-field">
                <label class="rd-label" for="nt-due">@L["ta.fDue"]</label>
                <input id="nt-due" name="due" type="date" class="rd-control">
            </div>
            <div class="rd-field">
                <label class="rd-label" for="nt-desc">@L["ta.fDesc"]</label>
                <textarea id="nt-desc" name="desc" class="rd-control" placeholder="@L["ta.fDescPh"]"></textarea>
                <div class="rd-help">@L["ta.fDescHelp"]</div>
            </div>
        </div>
        <div class="rd-dialog-foot">
            <button type="button" class="rd-btn" data-dialog-close>@SL["common.cancel"]</button>
            <button type="submit" class="rd-btn-primary">@L["ta.create"]</button>
        </div>
    </form>
</dialog>

@* Bulk transfer dialog: invented UI (the mockup's toolbar button has no dialog) so
   "Aktar" actually works — tickets dlg-bulk-status precedent; flagged in ROADMAP. *@
<dialog class="rd-dialog" id="dlg-bulk-transfer">
    <div class="rd-dialog-head">
        <span>@L["ta.transfer"]</span>
        <button class="close" data-dialog-close>✕</button>
    </div>
    <div class="rd-dialog-body">
        <div class="rd-field">
            <label class="rd-label">@L["ta.fDept"]</label>
            <select class="rd-control" name="departmentId" form="ta-bulk">
                @foreach (var dept in Model.Departments)
                {
                    <option value="@dept.Id">@dept.Name</option>
                }
            </select>
        </div>
    </div>
    <div class="rd-dialog-foot">
        <button type="button" class="rd-btn" data-dialog-close>@SL["common.cancel"]</button>
        <button type="submit" class="rd-btn-primary" form="ta-bulk" name="act" value="transfer">@SL["common.apply"]</button>
    </div>
</dialog>

@* Bulk delete confirm dialog: invented UI (B2), hard delete through TaskService. *@
<dialog class="rd-dialog" id="dlg-bulk-delete">
    <div class="rd-dialog-head">
        <span>@SL["common.delete"]</span>
        <button class="close" data-dialog-close>✕</button>
    </div>
    <div class="rd-dialog-body">
        <p>@L["ta.deleteConfirm"]</p>
    </div>
    <div class="rd-dialog-foot">
        <button type="button" class="rd-btn" data-dialog-close>@SL["common.cancel"]</button>
        <button type="submit" class="rd-btn rd-btn-danger" form="ta-bulk" name="act" value="delete">@SL["common.delete"]</button>
    </div>
</dialog>
